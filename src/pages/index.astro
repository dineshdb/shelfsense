/* =========================================================== RENDER */
function render() {
  const barEl = document.querySelector('.appbar');
  const navEl = document.querySelector('.nav');
  if (!set().setupDone) {
    if (barEl) barEl.style.display = 'none';
    $('#view').innerHTML = vSetup();
    $('#sheet').innerHTML = '';
