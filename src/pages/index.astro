    } else if (U.scan.image) {
      analyze([U.scan.image]);
    } else {
      toast('No photos to scan', 'warn');
    }
  },
  voiceIntakeMic: () => {
    if (U.scan.voiceRecording) {
      if (U.voice.rec?.nativeRec) {
        try { U.voice.rec.nativeRec.abort(); } catch (e) {}
        U.voice.rec = null;
      }
      U.scan.voiceRecording = false;
      U.voice.recording = false;
      render();
      return;
    }

    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRec) {
      toast('Live microphone speech requires Chrome or Edge — please type product details below', 'warn', 5000);
      const typed = document.querySelector('#voiceIntakeTyped');
      if (typed) typed.focus();
      return;
    }

    try {
      const rec = new SpeechRec();
      rec.continuous = false;
      rec.interimResults = true;
      rec.lang = set().lang || 'en-US';
      U.scan.voiceRecording = true;
      U.voice.recording = true;
      U.scan.voiceText = '';
      render();

      let finalResult = '';
      rec.onresult = e => {
        let interim = '';
        for (let i = e.resultIndex; i < e.results.length; ++i) {
          const res = e.results[i];
          if (res.isFinal) finalResult += ' ' + (res[0]?.transcript || '');
          else interim += ' ' + (res[0]?.transcript || '');
        }
        finalResult = finalResult.trim();
        interim = interim.trim();
        if (finalResult) {
          U.scan.voiceText = finalResult;
          render();
        } else if (interim) {
          U.scan.voiceText = interim;
          render();
        }
      };

      rec.onend = () => {
        U.scan.voiceRecording = false;
        U.voice.recording = false;
        U.voice.rec = null;
        const text = finalResult.trim() || (U.scan.voiceText || '').trim();
        if (text) {
          intakeVoiceCommand(text);
        } else {
          render();
        }
      };

      rec.onerror = e => {
        console.warn('Voice intake mic error:', e.error);
        U.scan.voiceRecording = false;
        U.voice.recording = false;
        U.voice.rec = null;
        render();
        if (e.error === 'not-allowed') {
          toast('🎙️ Microphone access denied — click the 🔒 icon in Chrome address bar to Allow microphone', 'err', 5000);
        } else if (e.error !== 'no-speech') {
          toast('🎙️ Mic capture error: ' + e.error + ' — please type product details', 'warn', 4000);
        }
      };

      U.voice.rec = { nativeRec: rec };
      rec.start();
    } catch (err) {
      U.scan.voiceRecording = false;
      U.voice.recording = false;
      render();
      toast('Could not start microphone: ' + err.message, 'err', 4000);
    }
  },
  voiceIntakeTyped: () => {
    const el = document.querySelector('#voiceIntakeTyped');
    const text = el ? el.value.trim() : '';
