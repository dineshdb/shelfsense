/* =========================================================== SCAN */
async function startCam() {
  if (!navigator.mediaDevices?.getUserMedia) { toast('Live camera needs HTTPS — opening photo capture instead', 'warn'); $('#photoIn').click(); return; }
  try {
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false });
    U.scan.image = null; U.scan.dets = []; U.scan.camOn = true; render();
  } catch (e) { toast('Camera unavailable (' + e.message + ') — opening photos', 'warn', 4500); $('#photoIn').click(); }
}
function stopCam() { U.scan.live = false; clearTimeout(liveTimer); if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; } U.scan.camOn = false; }
function capture() {
  const v = $('#video'); if (!v || !v.videoWidth) return toast('Camera not ready yet', 'warn');
  const k = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight)), c = document.createElement('canvas'); c.width = v.videoWidth * k; c.height = v.videoHeight * k;
  c.getContext('2d').drawImage(v, 0, 0, c.width, c.height); const url = c.toDataURL('image/jpeg', .85); stopCam(); analyze([url]);
}
async function frames(file, n) {
  const url = URL.createObjectURL(file), v = document.createElement('video'); v.muted = true; v.playsInline = true; v.preload = 'auto'; v.src = url;
  await new Promise((res, rej) => { v.onloadedmetadata = res; v.onerror = () => rej(new Error('This video format cannot be read')); });
  const dur = isFinite(v.duration) && v.duration > 0 ? v.duration : 1, out = [];
  for (let i = 0; i < n; i++) {
    await new Promise(res => { const done = () => { v.removeEventListener('seeked', done); res(); }; v.addEventListener('seeked', done); v.currentTime = dur * (i + .5) / n; setTimeout(done, 2500); });
    const k = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight)), c = document.createElement('canvas'); c.width = v.videoWidth * k; c.height = v.videoHeight * k;
    c.getContext('2d').drawImage(v, 0, 0, c.width, c.height); out.push(c.toDataURL('image/jpeg', .8));
  }
  URL.revokeObjectURL(url); return out;
}
async function esp() {
  const u = set().espUrl; if (!u) return toast('Set the ESP32-CAM URL in Settings', 'warn');
  U.scan.busy = true; U.scan.status = 'Grabbing frame from ESP32-CAM…'; render();
  try { const r = await fetch(u + (u.includes('?') ? '&' : '?') + '_t=' + Date.now(), { cache: 'no-store' }); if (!r.ok) throw new Error('HTTP ' + r.status);
    const d = await resize(await fileToURL(await r.blob())); U.scan.busy = false; analyze([d]); }
  catch (e) { U.scan.busy = false; render(); toast('ESP32-CAM unreachable (' + e.message + '). Same Wi-Fi? Open the app over http on your LAN.', 'err', 6000); }
}
async function loadCoco() {
  if (coco) return coco;
  U.scan.status = 'Loading on-device AI model (first time only)…'; render();
  if (!window.tf) await loadScript('https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js');
  if (!window.cocoSsd) await loadScript('https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3/dist/coco-ssd.min.js');
  coco = await cocoSsd.load({ base: 'lite_mobilenet_v2' }); return coco;
}
async function cocoDetect(url) {
  const m = await loadCoco(); U.scan.status = 'Detecting items on-device…'; render();
  const img = await new Promise((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = url; });
  const g = {};
  (await m.detect(img, 40, .35)).forEach(p => {
    if (p.class === 'person') return;
    const [name, cat] = COCO[p.class] || [p.class[0].toUpperCase() + p.class.slice(1), 'Other'], [x, y, w, h] = p.bbox;
    const b = [y / img.height * 1000, x / img.width * 1000, (y + h) / img.height * 1000, (x + w) / img.width * 1000];
    const e = g[name] || (g[name] = { name, category: cat, count: 0, unit: 'unit', confidence: 0, bs: [] }); e.count++; e.confidence = Math.max(e.confidence, p.score); e.bs.push(b);
  });
  return Object.values(g).map(e => ({ ...e, box: [Math.min(...e.bs.map(b => b[0])), Math.min(...e.bs.map(b => b[1])), Math.max(...e.bs.map(b => b[2])), Math.max(...e.bs.map(b => b[3]))] }));
}
async function geminiDetect(imgs) {
  const prompt = `You are the inventory vision system of a small grocery store. ${imgs.length > 1 ? `These ${imgs.length} images are frames from one video sweep of the same shelves; merge them and do NOT double-count items seen in several frames.` : 'Analyze the shelf image.'}
Identify every distinct retail product. Read brand and size from packaging when legible (e.g. "Coca-Cola 600ml"), else use a clear generic name ("Bananas", "White Sugar 1kg").
Return ONLY a JSON array, one object per distinct product: {"name": string, "category": one of ${JSON.stringify(Object.keys(CAT))}, "count": integer visible units (estimate kg for loose produce), "unit": "unit"|"kg"|"L"|"pack", "confidence": 0-1, "price_guess": typical local retail price number or null, "box_2d": [ymin,xmin,ymax,xmax] normalized 0-1000 around all units of that product in the FIRST image, or null}.`;
  const r = await gemini([{ text: prompt }, ...imgs.map(d => ({ inline_data: { mime_type: 'image/jpeg', data: d.split(',')[1] } }))]);
  return (Array.isArray(r) ? r : (r.products || r.items || [])).filter(x => x && x.name).map(x => ({ name: x.name, category: x.category, count: Math.round(+x.count || 1), unit: x.unit, confidence: x.confidence, price: x.price_guess, box: x.box_2d || null }));
}
async function analyze(imgs) {
  const sc = U.scan; sc.image = imgs[0]; sc.dets = []; sc.busy = true;
  const useG = set().engine === 'gemini' || (set().engine === 'auto' && aiReady());
  sc.status = useG ? `Gemini is identifying products in ${imgs.length} image${imgs.length > 1 ? 's' : ''}…` : 'Preparing on-device AI…'; render();
  let d = [];
  try { if (useG) { d = await geminiDetect(imgs); sc.engine = aiLabel(); } else { d = await cocoDetect(imgs[0]); sc.engine = 'On-device COCO-SSD'; } }
  catch (e) {
    if (useG && set().engine === 'auto') { toast(aiLabel() + ' failed — using on-device model. ' + e.message, 'warn', 5000); try { d = await cocoDetect(imgs[0]); sc.engine = 'On-device COCO-SSD'; } catch (e2) { toast(e2.message, 'err', 5000); } }
    else toast(e.message, 'err', 5000);
  }
  sc.busy = false;
  sc.dets = d.map(x => { const m = Core.matchProduct(x.name, S.products); return { name: x.name, category: CAT[x.category] ? x.category : 'Other', count: Math.max(0, +x.count || 1), unit: UNITS.includes(x.unit) ? x.unit : 'unit', price: m.product ? m.product.price : (+x.price || null), confidence: x.confidence, box: x.box, include: true, matchId: m.product?.id || null }; });
  render();
  if (d.length) toast(`Found ${d.length} product type${d.length > 1 ? 's' : ''}`, 'ok'); else toast('No products recognized — try a closer, well-lit photo' + (aiReady() ? '' : ' or configure an AI backend'), 'warn', 5000);
}
