      window.__firebase = { initializeApp, getAuth, signInAnonymously, onAuthStateChanged, getFirestore, doc, getDoc, onSnapshot, runTransaction };

/* ===== ShelfSense AI v2 — dependency-free UI ===== */
(() => {
const DAY = 864e5, KEY = 'shelfsense_v1';
const $ = s => document.querySelector(s);
const uid = () => Math.random().toString(36).slice(2, 9) + Date.now().toString(36).slice(-4);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const CAT = { Produce: '🥬', Fruits: '🍌', Vegetables: '🥕', Dairy: '🥛', Bakery: '🍞', Beverages: '🥤', Grains: '🌾', Pantry: '🥫', Snacks: '🍪', Household: '🧴', 'Personal Care': '🧼', Meat: '🥩', Frozen: '🧊', Other: '📦' };
const NAME_EMOJI = [[/sugar|azucar/, '🍬'], [/rice|arroz/, '🍚'], [/milk|leche/, '🥛'], [/bread|\bpan\b/, '🍞'], [/egg|huevo/, '🥚'], [/oil|aceite/, '🫗'], [/cola|coke|soda/, '🥤'], [/banana|banano/, '🍌'], [/tomato|tomate/, '🍅'], [/pasta|spaghetti/, '🍝'], [/coffee|cafe/, '☕'], [/soap|jabon/, '🧼'], [/salt|\bsal\b/, '🧂'], [/bean|frijol/, '🫘'], [/apple|manzana/, '🍎'], [/orange|naranja/, '🍊'], [/water|agua/, '💧'], [/cheese|queso/, '🧀'], [/chicken|pollo/, '🍗'], [/carrot|zanahoria/, '🥕'], [/broccoli/, '🥦'], [/beer|cerveza/, '🍺'], [/chip|snack/, '🍟']];
const UNITS = ['unit', 'kg', 'g', 'L', 'ml', 'pack'];
const DEF = { storeName: 'My Grocery Store', currency: '$', apiKey: '', model: 'gemini-2.5-flash', aiMode: 'gemini', aiBaseUrl: '', aiModel: 'gemma-4-e4b', setupDone: false, lang: 'en-US', autoApply: true, speak: true, leadDays: 3, coverDays: 7, safetyDays: 2, windowDays: 28 };
const I = {
  logo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20.5" r="1.3"/><circle cx="17" cy="20.5" r="1.3"/><path d="M12 8.5l1 2 2 .4-1.5 1.4.4 2-1.9-1-1.9 1 .4-2-1.5-1.4 2-.4z" fill="currentColor" stroke="none"/></svg>',
