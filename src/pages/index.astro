/* ===== ShelfSense Core: voice parsing, product matching, analytics (pure functions) ===== */
const Core = (() => {
  const DAY = 864e5;
  const strip = s => (s || '').toString().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  const NUM = { a: 1, an: 1, one: 1, un: 1, uno: 1, una: 1, two: 2, dos: 2, three: 3, tres: 3, four: 4, cuatro: 4,
    five: 5, cinco: 5, six: 6, seis: 6, seven: 7, siete: 7, eight: 8, ocho: 8, nine: 9, nueve: 9, ten: 10, diez: 10,
    eleven: 11, once: 11, twelve: 12, doce: 12, fifteen: 15, quince: 15, twenty: 20, veinte: 20, thirty: 30, treinta: 30,
    fifty: 50, cincuenta: 50, hundred: 100, cien: 100, half: 0.5, medio: 0.5, media: 0.5, quarter: 0.25, cuarto: 0.25,
    couple: 2, par: 2 };
  const UNIT_RULES = [
    [/^(kilograms?|kilos?|kgs?|kilogramos?)$/, 'kg'],
    [/^(grams?|grammes?|g|gr|grs|gramos?)$/, 'g'],
    [/^(liters?|litres?|l|lts?|litros?)$/, 'L'],
    [/^(milliliters?|millilitres?|ml|mililitros?)$/, 'ml'],
    [/^(packs?|packets?|packages?|paquetes?|bags?|bolsas?|boxes?|cajas?)$/, 'pack'],
    [/^(units?|pieces?|pcs|unidades?|bottles?|botellas?|cans?|latas?|loaves|loaf|bars?|barras?)$/, 'unit'],
    [/^(dozens?|docenas?)$/, 'dozen']
  ];
  const SALE = new Set(['sold', 'sell', 'sells', 'selling', 'sale', 'sales', 'vendi', 'vendio', 'vendido', 'vendida',
    'vendidos', 'vendidas', 'vendimos', 'venta', 'vender', 'vende']);
  const RESTOCK = new Set(['received', 'receive', 'restock', 'restocked', 'added', 'add', 'arrived', 'delivered',
    'delivery', 'recibi', 'recibimos', 'llegaron', 'llego', 'compre', 'compramos', 'agregar', 'agrega', 'agregue',
    'reponer', 'repuse', 'entrada', 'ingreso']);
  const STOP = new Set(['of', 'de', 'del', 'the', 'el', 'la', 'los', 'las', 'i', 'we', 'yo', 'just', 'have', 'has',
    'been', 'was', 'were', 'se', 'please', 'por', 'favor', 'for', 'to', 'customer', 'cliente', 'today', 'hoy', 'more',
    'mas', 'stock', 'inventory', 'inventario', 'some', 'unos', 'unas', 'que', 'and', 'y', 'with', 'con', 'en', 'in',
    'it', 'is', 'are', 'my', 'mi', 'al', 'lo', 'le', 'les', 'item', 'items', 'product', 'producto', 'plushalf']);

  const unitOf = tok => { for (const [re, u] of UNIT_RULES) if (re.test(tok)) return u; return null; };
  const isSaleWord = w => SALE.has(w);
  const isRestockWord = w => RESTOCK.has(w);

  function lev(a, b) {
    const m = a.length, n = b.length; if (!m) return n; if (!n) return m;
    let prev = Array.from({ length: n + 1 }, (_, j) => j);
    for (let i = 1; i <= m; i++) {
      const cur = [i];
      for (let j = 1; j <= n; j++) cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
      prev = cur;
    }
    return prev[n];
  }
  const sim = (a, b) => {
    if (a === b) return 1;
    if (a.length > 3 && b.length > 3 && (a.startsWith(b) || b.startsWith(a))) return 0.9;
    return 1 - lev(a, b) / Math.max(a.length, b.length);
  };
  const toks = s => strip(s).replace(/[^a-z0-9\s]/g, ' ').split(/\s+/)
    .filter(t => t.length > 1 && !/\d/.test(t) && !STOP.has(t) && !unitOf(t) && !isSaleWord(t) && !isRestockWord(t));

  function matchProduct(query, products) {
    const q = toks(query);
    if (!q.length || !products.length) return { product: null, score: 0 };
    let best = null, bestScore = 0;
    for (const p of products) {
      for (const cand of [p.name, ...(p.aliases || [])]) {
        const c = toks(cand); if (!c.length) continue;
        const recall = q.reduce((s, t) => s + Math.max(...c.map(x => sim(t, x))), 0) / q.length;
        const prec = c.reduce((s, t) => s + Math.max(...q.map(x => sim(t, x))), 0) / c.length;
        const sc = 0.65 * recall + 0.35 * prec;
        if (sc > bestScore) { bestScore = sc; best = p; }
      }
    }
    return bestScore >= 0.62 ? { product: best, score: bestScore } : { product: null, score: bestScore, suggestion: best };
  }

  function convertQty(qty, said, pu) {
    if (!said || said === pu) return qty;
    if (said === 'dozen') return pu === 'unit' ? qty * 12 : qty;
    if (said === 'g' && pu === 'kg') return qty / 1000;
    if (said === 'kg' && pu === 'g') return qty * 1000;
    if (said === 'ml' && pu === 'L') return qty / 1000;
    if (said === 'L' && pu === 'ml') return qty * 1000;
    return qty;
  }

  function parseCommand(text, products) {
    let t = ' ' + strip(text) + ' ';
    t = t.replace(/(\d)\s*\/\s*(\d)/g, (m, a, b) => ' ' + (Number(a) / Number(b)) + ' ');
    t = t.replace(/(\d),(\d)/g, '$1.$2').replace(/(\d)([a-z])/g, '$1 $2');
    t = t.replace(/\b(and a half|and half|y medio|y media)\b/g, ' plushalf ');
    t = t.replace(/[^a-z0-9.,;\s]/g, ' ');
    const all = t.replace(/[,;]/g, ' ').split(/\s+/).map(w => w.replace(/^\.+|\.+$/g, '')).filter(Boolean);
    const hasSale = all.some(isSaleWord), hasRestock = all.some(isRestockWord);
    const intent = hasRestock && !hasSale ? 'restock' : 'sale';
    const segments = t.split(/\s(?:and|y|plus|also|tambien)\s|[,;]/);
    const items = [];
    for (const seg of segments) {
      const words = seg.split(/\s+/).map(w => w.replace(/^\.+|\.+$/g, '')).filter(Boolean);
      let qty = null, unit = null, half = false; const name = [];
      for (const w of words) {
        if (isSaleWord(w) || isRestockWord(w)) continue;
        if (w === 'plushalf') { half = true; continue; }
        if (/^\d+(\.\d+)?$/.test(w)) { if (qty === null) qty = parseFloat(w); continue; }
        if (NUM[w] !== undefined) { if (qty === null) qty = NUM[w]; continue; }
        const u = unitOf(w);
        if (u) { if (!unit) unit = u; continue; }
        if (STOP.has(w)) continue;
        name.push(w);
      }
      if (!name.length) continue;
      if (qty === null) qty = 1;
      if (half) qty += 0.5;
      const query = name.join(' ');
      const m = matchProduct(query, products);
      items.push({ raw: seg.trim(), query, qty, unit, productId: m.product ? m.product.id : null,
        productName: m.product ? m.product.name : null, score: +m.score.toFixed(2),
        suggestionId: m.suggestion ? m.suggestion.id : null });
    }
    return { text, intent, items };
  }

  function dailySeries(moves, days, now = Date.now()) {
    const start = new Date(now); start.setHours(0, 0, 0, 0);
    const out = [];
    for (let i = days - 1; i >= 0; i--) {
      const d0 = start.getTime() - i * DAY, d1 = d0 + DAY;
      const rev = moves.filter(m => m.type === 'sale' && m.ts >= d0 && m.ts < d1).reduce((s, m) => s + (m.total || 0), 0);
      out.push({ label: new Date(d0).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }), value: +rev.toFixed(2) });
    }
    return out;
  }

  function analyze(products, moves, s, now = Date.now()) {
    const sales = moves.filter(m => m.type === 'sale');
    const first = sales.length ? Math.min(...sales.map(m => m.ts)) : now;
    const windowDays = Math.max(1, Math.min(s.windowDays || 28, Math.floor((now - first) / DAY) + 1));
    const lead = +s.leadDays || 0, cover = +s.coverDays || 0, safety = +s.safetyDays || 0;
    const rows = products.map(p => {
      const ps = sales.filter(m => m.productId === p.id);
      const win = ps.filter(m => m.ts >= now - windowDays * DAY);
      const last7 = ps.filter(m => m.ts >= now - 7 * DAY);
      const sold = win.reduce((a, m) => a + m.qty, 0);
      const qty7 = last7.reduce((a, m) => a + m.qty, 0);
      const rev7 = last7.reduce((a, m) => a + (m.total || 0), 0);
      const revWin = win.reduce((a, m) => a + (m.total || 0), 0);
      const avgDaily = sold / windowDays;
      const recentDaily = qty7 / Math.min(7, windowDays);
      const daysLeft = avgDaily > 0 ? p.stock / avgDaily : Infinity;
      const lastSale = ps.length ? Math.max(...ps.map(m => m.ts)) : null;
      const rop = (p.minStock !== null && p.minStock !== undefined && p.minStock !== '') ? +p.minStock : avgDaily * (lead + safety);
      const target = avgDaily * (lead + cover + safety);
      let reorderQty = Math.max(0, target - p.stock);
      reorderQty = p.unit === 'kg' || p.unit === 'L' ? Math.ceil(reorderQty) : Math.ceil(reorderQty);
      let status = 'ok';
      if (p.stock <= 0) status = 'out';
      else if (p.stock <= rop && (avgDaily > 0 || rop > 0)) status = 'low';
      else if ((!lastSale || now - lastSale > 14 * DAY) || (avgDaily > 0 && daysLeft > 60)) status = 'slow';
      if ((status === 'low' || status === 'out') && reorderQty === 0) reorderQty = Math.max(1, Math.ceil(rop - p.stock + 1));
      const trend = avgDaily > 0 ? (recentDaily - avgDaily) / avgDaily : 0;
      return { id: p.id, p, sold, qty7, rev7, revWin, avgDaily, recentDaily, daysLeft, lastSale, rop, reorderQty,
        status, trend, reorderCost: reorderQty * (p.cost || p.price * 0.75 || 0) };
    });
    return { windowDays, rows };
  }

  return { strip, matchProduct, parseCommand, convertQty, analyze, dailySeries, sim };
})();



