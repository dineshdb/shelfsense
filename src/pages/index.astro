    ['Potatoes', 'Vegetables', 'kg', 18, 0.90, 0.60, 2.0, ['potato', 'patata', 'aloo', 'alu'], '4072'],
    ['Wheat Flour (Atta)', 'Grains', 'kg', 25, 1.20, 0.85, 2.5, ['atta', 'aata', 'flour', 'harina'], '8901234567896'],
    ['Tea (Chai)', 'Beverages', 'pack', 15, 2.50, 1.80, 1.0, ['tea', 'chai', 'chiya', 'te'], '8901234567897']
  ];

  S.products = [];
  S.moves = [];
  P.forEach(([name, category, unit, stock, price, cost, rate, aliases, barcode], k) => {
    const id = 'p' + k;
    S.products.push({ id, name, category, unit, stock, price, cost, aliases, barcode: barcode || '', minStock: null, createdAt: now - 22 * DAY });
    for (let d = 21; d >= 0; d--) {
      const day = new Date(now - d * DAY);
      const wk = [0, 6].includes(day.getDay()) ? 1.35 : 1;
      const ramp = name.startsWith('Coca') ? 0.7 + (21 - d) / 35 : 1;
      let q = rate * wk * ramp * (0.5 + R());
      if (d === 0) q *= Math.min(1, (new Date().getHours() + 1) / 20);
      const tx = Math.max(0, Math.round(q / (unit === 'kg' ? 1.5 : 2)));
      for (let t = 0; t < tx; t++) {
        const qq = unit === 'kg' ? Math.max(0.25, Math.round(q / tx * 4) / 4) : Math.max(1, Math.round(q / tx));
        const ts = new Date(day);
        ts.setHours(7 + Math.floor(R() * 12), Math.floor(R() * 60), 0, 0);
        if (ts.getTime() > now) continue;
        S.moves.push({
          id: uid(),
          productId: id,
          type: 'sale',
          qty: qq,
          delta: -qq,
          unitPrice: price,
          total: +(qq * price).toFixed(2),
          ts: ts.getTime(),
          source: 'demo'
        });
      }
    }
  });

  S.khata = {
    'Ramesh Sharma': {
      name: 'Ramesh Sharma',
