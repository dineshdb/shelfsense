/* ---------- Business Actions & Advisor ---------- */
async function advisor() {
  U.ai.busy = true;
  U.ai.text = '';
  render();
  const cur = set().currency;
  const a = Core.analyze(S.products, S.moves, set());
  const rows = a.rows;
  if (aiReady()) {
    try {
      const facts = rows.map(r => ({
        product: r.p.name,
        unit: r.p.unit,
        stock: +r.p.stock.toFixed(2),
        avgDaily: +r.avgDaily.toFixed(2),
        qty7d: +r.qty7.toFixed(2),
        revenue7d: +r.rev7.toFixed(2),
        trendPct: Math.round(r.trend * 100),
        daysLeft: isFinite(r.daysLeft) ? +r.daysLeft.toFixed(1) : null,
        status: r.status,
        recommendedOrder: r.reorderQty
      }));
      U.ai.text = await gemini([{
        text: `You are the AI employee of the small grocery store "${set().storeName}". Currency ${cur}. Supplier lead time ${set().leadDays} days.
Per-product data computed from real sales: ${JSON.stringify(facts)}
Write a friendly briefing for the owner in ${set().lang.startsWith('es') ? 'Spanish' : 'English'} (max 140 words, plain text with emoji headers, no tables): 1) What's selling (top 3) 2) What's running out and exactly how much to reorder 3) Slow items + one action 4) One growth tip. Only use the numbers given.`
      }], false);
      U.ai.busy = false;
      return render();
    } catch (e) {
      toast('Gemini unavailable — using built-in analysis', 'warn');
    }
  }

  const best = rows.filter(r => r.rev7 > 0).sort((x, y) => y.rev7 - x.rev7).slice(0, 3);
  const low = rows.filter(r => r.status === 'low' || r.status === 'out').sort((x, y) => x.daysLeft - y.daysLeft).slice(0, 4);
  const slow = rows.filter(r => r.status === 'slow').slice(0, 3);
  const re = rows.filter(r => r.reorderQty > 0 && r.status !== 'slow');

  U.ai.text = [
    '📈 Selling: ' + (best.length ? best.map(r => `${r.p.name} (${money(r.rev7, cur)} this week${r.trend > 0.1 ? ', trending up' : ''})`).join('; ') : 'no sales recorded yet') + '.',
    '🚨 Running out: ' + (low.length ? low.map(r => `${r.p.name} — ${fq(r.p.stock, r.p.unit)} left (${daysTxt(r.daysLeft)}), order ${fq(r.reorderQty, r.p.unit)}`).join('; ') : 'nothing critical') + '.',
    '🐢 Slow: ' + (slow.length ? slow.map(r => r.p.name).join(', ') + ' — pause reorders and try a bundle or small discount' : 'none') + '.',
    `🛒 Next purchase: ${re.length} products, about ${money(re.reduce((s, r) => s + r.reorderCost, 0), cur)}.`
  ].join('\n\n');

  U.ai.busy = false;
  render();
}

async function share() {
  const cur = set().currency;
  const rows = Core.analyze(S.products, S.moves, set()).rows.filter(r => r.reorderQty > 0 && r.status !== 'slow').sort((x, y) => x.daysLeft - y.daysLeft);
  if (!rows.length) return;
  const text = `🛒 ${set().storeName} — purchase order ${new Date().toLocaleDateString()}\n${rows.map(r => `• ${r.p.name}: ${fq(r.reorderQty, r.p.unit)}`).join('\n')}\nEst. total: ${money(rows.reduce((s, r) => s + r.reorderCost, 0), cur)}`;
  try {
    if (navigator.share) await navigator.share({ title: 'Purchase order', text });
    else {
      await navigator.clipboard.writeText(text);
      toast('Order list copied — paste into WhatsApp or email', 'ok');
    }
  } catch (e) {
    if (e.name !== 'AbortError') prompt('Copy your order list:', text);
  }
}

function rng(s) {
  return () => {
    s |= 0; s = s + 0x6D2B79F5 | 0;
    let t = Math.imul(s ^ s >>> 15, 1 | s);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

