    else { p = { id: uid(), name: d.name.trim(), aliases: [], category: d.category, unit: d.unit, stock: q, price: +d.price || 0, cost: d.price ? +(d.price * .75).toFixed(2) : 0, minStock: null, createdAt: Date.now() };
