  }
  if (barEl) barEl.style.display = '';
  $('#storeName').textContent = set().storeName;
  const pill = $('#enginePill'); if (pill) { pill.className = 'pill ' + (aiReady() ? '' : 'off'); pill.innerHTML = `<i></i>${aiReady() ? aiLabel() : 'AI off'}`; }
  const V = { home: vHome, scan: vScan, sell: vSell, stock: vStock, settings: vSettings }[U.tab];
  $('#view').innerHTML = `<div class="view">${V()}</div>`;
  $('#sheet').innerHTML = vSheet();
  document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('on', b.dataset.v === U.tab));
  if (U.tab === 'scan') {
    const v = $('#video'); if (v && stream) { v.srcObject = stream; v.play().catch(() => {}); }
    const img = $('#shot'); if (img) { const draw = () => drawBoxes($('#shotCv'), img.naturalWidth, img.naturalHeight, U.scan.dets); img.complete ? draw() : img.onload = draw; }
