  if (type === 'sale') { if (p.stock <= 0) return toast(p.name + ' is out of stock', 'warn'); const q = Math.min(step, p.stock); p.stock = +(p.stock - q).toFixed(3);
    S.moves.push({ id: uid(), productId: id, type: 'sale', qty: q, delta: -q, unitPrice: p.price, total: +(q * p.price).toFixed(2), ts: Date.now(), source: 'manual' }); }
  else { p.stock = +(p.stock + step).toFixed(3); S.moves.push({ id: uid(), productId: id, type: 'restock', qty: step, delta: step, ts: Date.now(), source: 'manual' }); }
