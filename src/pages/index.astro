  const text = `🛒 ${set().storeName} — purchase order ${new Date().toLocaleDateString()}\n${rows.map(r => `• ${r.p.name}: ${fq(r.reorderQty, r.p.unit)}`).join('\n')}\nEst. total: ${money(rows.reduce((s, r) => s + r.reorderCost, 0))}`;
