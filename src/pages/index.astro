    else if (t.dataset.k === 'include') render(); }
  if (t.dataset.pk) { U.voice.parsed.intent = t.value; render(); }
  if (t.id === 'photoIn') { const fs = [...t.files].slice(0, 6); t.value = ''; if (fs.length) Promise.all(fs.map(f => fileToURL(f).then(d => resize(d)))).then(analyze).catch(e => toast(e.message, 'err')); }
  if (t.id === 'videoIn') { const f = t.files[0]; t.value = ''; if (!f) return; U.scan.busy = true; U.scan.status = 'Extracting frames from video…'; render(); frames(f, 5).then(fr => { U.scan.busy = false; analyze(fr); }).catch(e => { U.scan.busy = false; render(); toast(e.message, 'err'); }); }
  if (t.id === 'importIn') { const f = t.files[0]; t.value = ''; if (!f) return; f.text().then(x => { const d = JSON.parse(x); S.products = d.products || []; S.moves = d.moves || []; if (d.settings) Object.assign(S.settings, { ...d.settings, apiKey: S.settings.apiKey }); save(); render(); toast('Imported', 'ok'); }).catch(() => toast('Invalid file', 'err')); }
});
document.addEventListener('keydown', ev => { if (ev.key === 'Enter' && ev.target.id === 'typed') ACT.typed(); if (ev.key === 'Escape' && U.edit) { U.edit = null; render(); } });

/* ---------- firebase cloud sync (AI Builder Cup: deployed on Firebase) ----
   Anonymous auth + one Firestore doc per device-user. Newest state wins on
   boot (savedAt); afterwards every save() mirrors to the cloud (debounced)
   and remote writes that are NEWER than local apply live — multi-device
   sync for free. No config / no network = the app stays local-only. */
window.__cloudPut = null;
(function cloud() {
  const FB = window.__firebase, cfg = window.FIREBASE_CONFIG || {};
  const pillEl = $('#cloudPill');
  const setPill = (on, label) => { pillEl.style.display = ''; pillEl.className = 'pill ' + (on ? '' : 'off'); pillEl.innerHTML = '<i></i>' + label; };
  if (!FB || !cfg.apiKey) return; // local-only mode: pill stays hidden
  let timer = null, uid = null, applying = false;
  const push = () => {
    if (!uid) return;
    clearTimeout(timer);
    timer = setTimeout(() => setDoc(FB.doc(FB.getFirestore(app), 'users', uid), JSON.parse(JSON.stringify(S))).catch(() => setPill(false, 'Cloud offline')), 1200);
  };
  window.__cloudPut = push;
  let app;
  try { app = FB.initializeApp(cfg); } catch (e) { return; }
  const db = FB.getFirestore(app);
  setPill(false, 'Connecting…');
  FB.signInAnonymously(FB.getAuth(app)).catch(() => setPill(false, 'Local'));
  FB.onAuthStateChanged(FB.getAuth(app), async (u) => {
    if (!u) { uid = null; setPill(false, 'Local'); return; }
    uid = u.uid;
    const ref = FB.doc(db, 'users', uid);
    try {
      const snap = await FB.getDoc(ref);
      if (snap.exists() && (snap.data().savedAt || 0) > (S.savedAt || 0)) {
        const d = snap.data();
        S.products = d.products || []; S.moves = d.moves || [];
        S.settings = Object.assign({}, DEF, d.settings || {});
        save(); render();
        toast('☁️ Loaded newer data from the cloud', 'ok');
      }
      setPill(true, 'Cloud');
      // live sync: a remote write newer than local applies (our own echoes
      // are older-or-equal and skipped)
      FB.onSnapshot(ref, (doc2) => {
        if (!doc2.exists() || applying) return;
        const d = doc2.data();
        if ((d.savedAt || 0) > (S.savedAt || 0)) {
          applying = true;
          S.products = d.products || []; S.moves = d.moves || [];
          S.settings = Object.assign({}, DEF, d.settings || {});
          save(); render(); applying = false;
        }
      });
    } catch (e) { setPill(false, 'Cloud offline'); }
  });
})();

/* boot */
$('#logo').innerHTML = I.logo;
document.querySelectorAll('.nav button').forEach(b => { const ic = { home: I.home, scan: I.scan, sell: I.mic, stock: I.box, settings: I.gear }[b.dataset.v]; b.insertAdjacentHTML('afterbegin', b.dataset.v === 'sell' ? `<span class="fabm">${ic}</span>` : ic); });
render();
setInterval(() => { if (U.tab === 'home' && !U.edit && !U.ai.busy && document.visibilityState === 'visible' && !document.activeElement?.matches('input,select')) render(); }, 60000);
})();

    </script>
