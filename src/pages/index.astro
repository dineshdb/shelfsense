  if (S.settings.storeName === DEF.storeName) S.settings.storeName = 'Abarrotes La Esquina';
  U.ai.text = '';
  save();
  go('home');
  toast('✨ Demo store loaded — 14 products with barcodes, 3 weeks sales, 2 Khata tabs', 'ok');
}

function quick(id, type) {
  const p = prod(id);
  const step = p.unit === 'g' || p.unit === 'ml' ? 100 : 1;
  if (type === 'sale') {
    if (p.stock <= 0) return toast(p.name + ' is out of stock', 'warn');
    const q = Math.min(step, p.stock);
    p.stock = +(p.stock - q).toFixed(3);
    S.moves.push({
      id: uid(),
      productId: id,
      type: 'sale',
      qty: q,
      delta: -q,
      unitPrice: p.price,
      total: +(q * p.price).toFixed(2),
      ts: Date.now(),
      source: 'manual'
    });
  } else {
    p.stock = +(p.stock + step).toFixed(3);
    S.moves.push({
      id: uid(),
      productId: id,
      type: 'restock',
      qty: step,
      delta: step,
      ts: Date.now(),
      source: 'manual'
    });
  }
  save();
  $('#stocklist').innerHTML = stockList(S, U);
}

function saveP() {
  const e = U.edit;
  const g = id => $('#' + id)?.value || '';
  const name = g('e_name').trim();
  if (!name) return toast('Name is required', 'warn');
  const barcode = g('e_barcode').trim();
  const aliases = g('e_alias').split(',').map(s => s.trim()).filter(Boolean);
  if (barcode && !aliases.includes(barcode)) aliases.push(barcode);
  const d = {
    name,
    barcode,
    aliases,
    category: g('e_cat'),
    unit: g('e_unit'),
    stock: +g('e_stock') || 0,
    minStock: g('e_min') === '' ? null : +g('e_min'),
    price: +g('e_price') || 0,
    cost: +g('e_cost') || 0
  };

  if (e.id) {
    const p = prod(e.id);
    const b = p.stock;
    Object.assign(p, d);
    if (b !== p.stock) {
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'adjust',
        qty: +(p.stock - b).toFixed(3),
        delta: +(p.stock - b).toFixed(3),
        ts: Date.now(),
        source: 'edit'
      });
    }
  } else {
    S.products.push({ id: uid(), createdAt: Date.now(), ...d });
  }
  U.edit = null;
  save();
  render();
  toast('Saved', 'ok');
}

