/* ---------- Business Actions & Advisor ---------- */
async function advisor() {
  U.ai.busy = true;
  U.ai.text = '';
  render();
  const cur = set().currency;
  const a = Core.analyze(S.products, S.moves, set());
  const rows = a.rows;
  if (aiReady()) {
    try {
      const facts = rows.map(r => ({
        product: r.p.name,
        unit: r.p.unit,
        stock: +r.p.stock.toFixed(2),
        avgDaily: +r.avgDaily.toFixed(2),
        qty7d: +r.qty7.toFixed(2),
        revenue7d: +r.rev7.toFixed(2),
        trendPct: Math.round(r.trend * 100),
        daysLeft: isFinite(r.daysLeft) ? +r.daysLeft.toFixed(1) : null,
        status: r.status,
        recommendedOrder: r.reorderQty
      }));
      U.ai.text = await gemini([{
        text: `You are the AI employee of the small grocery store "${set().storeName}". Currency ${cur}. Supplier lead time ${set().leadDays} days.
Per-product data computed from real sales: ${JSON.stringify(facts)}
Write a friendly briefing for the owner in ${set().lang.startsWith('es') ? 'Spanish' : 'English'} (max 140 words, plain text with emoji headers, no tables): 1) What's selling (top 3) 2) What's running out and exactly how much to reorder 3) Slow items + one action 4) One growth tip. Only use the numbers given.`
      }], false);
      U.ai.busy = false;
      return render();
    } catch (e) {
      toast('Gemini unavailable — using built-in analysis', 'warn');
    }
  }

  const best = rows.filter(r => r.rev7 > 0).sort((x, y) => y.rev7 - x.rev7).slice(0, 3);
  const low = rows.filter(r => r.status === 'low' || r.status === 'out').sort((x, y) => x.daysLeft - y.daysLeft).slice(0, 4);
  const slow = rows.filter(r => r.status === 'slow').slice(0, 3);
  const re = rows.filter(r => r.reorderQty > 0 && r.status !== 'slow');

  U.ai.text = [
    '📈 Selling: ' + (best.length ? best.map(r => `${r.p.name} (${money(r.rev7, cur)} this week${r.trend > 0.1 ? ', trending up' : ''})`).join('; ') : 'no sales recorded yet') + '.',
    '🚨 Running out: ' + (low.length ? low.map(r => `${r.p.name} — ${fq(r.p.stock, r.p.unit)} left (${daysTxt(r.daysLeft)}), order ${fq(r.reorderQty, r.p.unit)}`).join('; ') : 'nothing critical') + '.',
    '🐢 Slow: ' + (slow.length ? slow.map(r => r.p.name).join(', ') + ' — pause reorders and try a bundle or small discount' : 'none') + '.',
    `🛒 Next purchase: ${re.length} products, about ${money(re.reduce((s, r) => s + r.reorderCost, 0), cur)}.`
  ].join('\n\n');

  U.ai.busy = false;
  render();
}

async function share() {
  const cur = set().currency;
  const rows = Core.analyze(S.products, S.moves, set()).rows.filter(r => r.reorderQty > 0 && r.status !== 'slow').sort((x, y) => x.daysLeft - y.daysLeft);
  if (!rows.length) return;
  const text = `🛒 ${set().storeName} — purchase order ${new Date().toLocaleDateString()}\n${rows.map(r => `• ${r.p.name}: ${fq(r.reorderQty, r.p.unit)}`).join('\n')}\nEst. total: ${money(rows.reduce((s, r) => s + r.reorderCost, 0), cur)}`;
  try {
    if (navigator.share) await navigator.share({ title: 'Purchase order', text });
    else {
      await navigator.clipboard.writeText(text);
      toast('Order list copied — paste into WhatsApp or email', 'ok');
    }
  } catch (e) {
    if (e.name !== 'AbortError') prompt('Copy your order list:', text);
  }
}

function rng(s) {
  return () => {
    s |= 0; s = s + 0x6D2B79F5 | 0;
    let t = Math.imul(s ^ s >>> 15, 1 | s);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function demo() {
  if (S.products.length && !confirm('Replace current data with the demo store?')) return;
  const R = rng(42), now = Date.now(), P = [
    ['Sugar', 'Pantry', 'kg', 9, 1.10, 0.80, 2.4, ['azucar', 'white sugar'], '8901234567890'],
    ['Rice', 'Grains', 'kg', 32, 1.40, 1.00, 2.8, ['arroz'], '8901234567891'],
    ['Whole Milk 1L', 'Dairy', 'unit', 7, 1.25, 0.90, 4.6, ['milk', 'leche'], '012345678905'],
    ['Bread loaf', 'Bakery', 'unit', 6, 2.00, 1.30, 5.2, ['bread', 'pan'], '073410013589'],
    ['Eggs 12-pack', 'Dairy', 'pack', 11, 3.20, 2.40, 1.6, ['eggs', 'huevos'], '041383091234'],
    ['Cooking Oil 1L', 'Pantry', 'unit', 14, 3.50, 2.60, 0.9, ['oil', 'aceite'], '8901234567892'],
    ['Coca-Cola 600ml', 'Beverages', 'unit', 40, 1.00, 0.65, 6.5, ['coke', 'coca cola', 'soda', 'coca'], '5449000000996'],
    ['Bananas', 'Fruits', 'kg', 3, 0.70, 0.40, 3.1, ['banana', 'banano'], '4011'],
    ['Tomatoes', 'Vegetables', 'kg', 7, 1.60, 1.10, 1.5, ['tomato', 'tomate'], '4087'],
    ['Pasta 500g', 'Pantry', 'pack', 26, 0.90, 0.60, 1.2, ['pasta', 'spaghetti'], '8001234567893'],
    ['Ground Coffee 250g', 'Pantry', 'pack', 10, 4.50, 3.20, 0.45, ['coffee', 'cafe'], '8001234567894'],
    ['Black Beans', 'Grains', 'kg', 16, 1.80, 1.30, 1.1, ['beans', 'frijoles'], '012345678906'],
    ['Bar Soap', 'Personal Care', 'unit', 34, 0.80, 0.50, 0.15, ['soap', 'jabon'], '012345678907'],
    ['Salt 1kg', 'Pantry', 'unit', 22, 0.50, 0.30, 0.06, ['salt', 'sal'], '8901234567895']
  ];

  S.products = [];
  S.moves = [];
  P.forEach(([name, category, unit, stock, price, cost, rate, aliases, barcode], k) => {
    const id = 'p' + k;
    S.products.push({ id, name, category, unit, stock, price, cost, aliases, barcode: barcode || '', minStock: null, createdAt: now - 22 * DAY });
    for (let d = 21; d >= 0; d--) {
      const day = new Date(now - d * DAY);
      const wk = [0, 6].includes(day.getDay()) ? 1.35 : 1;
      const ramp = name.startsWith('Coca') ? 0.7 + (21 - d) / 35 : 1;
      let q = rate * wk * ramp * (0.5 + R());
      if (d === 0) q *= Math.min(1, (new Date().getHours() + 1) / 20);
      const tx = Math.max(0, Math.round(q / (unit === 'kg' ? 1.5 : 2)));
      for (let t = 0; t < tx; t++) {
        const qq = unit === 'kg' ? Math.max(0.25, Math.round(q / tx * 4) / 4) : Math.max(1, Math.round(q / tx));
        const ts = new Date(day);
        ts.setHours(7 + Math.floor(R() * 12), Math.floor(R() * 60), 0, 0);
        if (ts.getTime() > now) continue;
        S.moves.push({
          id: uid(),
          productId: id,
          type: 'sale',
          qty: qq,
          delta: -qq,
          unitPrice: price,
          total: +(qq * price).toFixed(2),
          ts: ts.getTime(),
          source: 'demo'
        });
      }
    }
  });

  S.khata = {
    'Ramesh Sharma': {
      name: 'Ramesh Sharma',
      balance: 14.50,
      txs: [
        { id: uid(), type: 'debit', amount: 14.50, ts: now - 2 * DAY, items: ['Cooking Oil 1L', 'Sugar 2kg'] }
      ]
    },
    'Priya Patel': {
      name: 'Priya Patel',
      balance: 8.20,
      txs: [
        { id: uid(), type: 'debit', amount: 8.20, ts: now - 4 * DAY, items: ['Whole Milk 1L', 'Eggs 12-pack'] }
      ]
    }
  };

  if (S.settings.storeName === DEF.storeName) S.settings.storeName = 'Abarrotes La Esquina';
  U.ai.text = '';
  save();
  go('home');
  toast('✨ Demo store loaded — 14 products with barcodes, 3 weeks sales, 2 Khata tabs', 'ok');
}

function quick(id, type) {
  const p = prod(id);
  const step = p.unit === 'g' || p.unit === 'ml' ? 100 : 1;
  if (type === 'sale') {
    if (p.stock <= 0) return toast(p.name + ' is out of stock', 'warn');
    const q = Math.min(step, p.stock);
    p.stock = +(p.stock - q).toFixed(3);
    S.moves.push({
      id: uid(),
      productId: id,
      type: 'sale',
      qty: q,
      delta: -q,
      unitPrice: p.price,
      total: +(q * p.price).toFixed(2),
      ts: Date.now(),
      source: 'manual'
    });
  } else {
    p.stock = +(p.stock + step).toFixed(3);
    S.moves.push({
      id: uid(),
      productId: id,
      type: 'restock',
      qty: step,
      delta: step,
      ts: Date.now(),
      source: 'manual'
    });
  }
  save();
  $('#stocklist').innerHTML = stockList(S, U);
}

function saveP() {
  const e = U.edit;
  const g = id => $('#' + id)?.value || '';
  const name = g('e_name').trim();
  if (!name) return toast('Name is required', 'warn');
  const barcode = g('e_barcode').trim();
  const aliases = g('e_alias').split(',').map(s => s.trim()).filter(Boolean);
  if (barcode && !aliases.includes(barcode)) aliases.push(barcode);
  const d = {
    name,
    barcode,
    aliases,
    category: g('e_cat'),
    unit: g('e_unit'),
    stock: +g('e_stock') || 0,
    minStock: g('e_min') === '' ? null : +g('e_min'),
    price: +g('e_price') || 0,
    cost: +g('e_cost') || 0
  };

  if (e.id) {
    const p = prod(e.id);
    const b = p.stock;
    Object.assign(p, d);
    if (b !== p.stock) {
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'adjust',
        qty: +(p.stock - b).toFixed(3),
        delta: +(p.stock - b).toFixed(3),
        ts: Date.now(),
        source: 'edit'
      });
    }
  } else {
    S.products.push({ id: uid(), createdAt: Date.now(), ...d });
  }
  U.edit = null;
  save();
  render();
  toast('Saved', 'ok');
}

