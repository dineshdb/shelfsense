function chart(s) {
  const W = 340, H = 150, pad = 18, max = Math.max(1, ...s.map(x => x.value)), bw = (W - pad) / s.length;
  let g = `<svg viewBox="0 0 ${W} ${H + 18}">`;
  [0, .5, 1].forEach(f => { const y = 6 + (H - 6) * (1 - f); g += `<line x1="${pad}" x2="${W}" y1="${y}" y2="${y}" stroke="var(--border)"/><text x="0" y="${y + 3}">${Math.round(max * f)}</text>`; });
  s.forEach((x, i) => {
    const bh = Math.max(2, (H - 6) * x.value / max), X = pad + i * bw + bw * .18, last = i === s.length - 1;
    g += `<rect x="${X}" y="${H - bh}" width="${bw * .64}" height="${bh}" rx="4" fill="${last ? 'var(--primary)' : 'var(--muted)'}"><title>${x.label}: ${money(x.value)}</title></rect>`;
    if (i % 2 === (s.length - 1) % 2) g += `<text x="${X + bw * .32}" y="${H + 14}" text-anchor="middle">${x.label.split(' ').reverse().join(' ')}</text>`;
  });
  return g + '</svg>';
}
