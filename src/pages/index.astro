/* =========================================================== VOICE */
function listen() {
  if (U.voice.listening) { try { rec.stop(); } catch (e) {} return; }
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return toast('Voice not supported in this browser — type the command (Chrome / Safari work best)', 'warn', 5000);
  if (!S.products.length) toast('Tip: add products first (Scan or Load demo)', 'warn');
  rec = new SR(); rec.lang = set().lang; rec.interimResults = true; rec.continuous = false;
  let fin = '';
  rec.onresult = e => { let t = ''; for (let i = 0; i < e.results.length; i++) t += e.results[i][0].transcript; U.voice.transcript = t; const el = $('#trans'); if (el) { el.textContent = '“' + t + '”'; el.classList.remove('ph2'); } if (e.results[e.results.length - 1].isFinal) fin = t; };
  rec.onerror = e => { if (!['no-speech', 'aborted'].includes(e.error)) toast('Mic error: ' + e.error + (e.error === 'not-allowed' ? ' — allow microphone access (HTTPS required)' : ''), 'err', 5000); };
  rec.onend = () => { U.voice.listening = false; const t = fin || U.voice.transcript; render(); if (t) command(t, 'voice'); };
  U.voice.transcript = ''; U.voice.parsed = null; U.voice.listening = true; render();
  try { rec.start(); } catch (e) { U.voice.listening = false; render(); toast(e.message, 'err'); }
}
async function command(text, source) {
  U.voice.transcript = text;
  let P = Core.parseCommand(text, S.products);
  if ((!P.items.length || P.items.some(i => !i.productId)) && aiReady() && S.products.length) {
    U.voice.busy = true; render();
    try {
      const r = await gemini([{ text: `You parse voice commands from a grocery shop owner (any language). Inventory product names: ${JSON.stringify(S.products.map(p => p.name))}.
Command: "${text}"
Return JSON {"intent":"sale"|"restock","items":[{"product": exact inventory name or null,"heard": what the owner said,"qty": number,"unit":"kg"|"g"|"L"|"ml"|"unit"|"pack"|"dozen"|null}]}. sold/vendí = sale; received/arrived/delivery/llegaron = restock.` }]);
      const items = (r.items || []).map(it => { const p = S.products.find(x => x.name === it.product) || (it.product && Core.matchProduct(it.product, S.products).product); return { query: it.heard || it.product || '?', qty: +it.qty || 1, unit: it.unit || null, productId: p?.id || null }; });
      if (items.length) P = { text, intent: r.intent === 'restock' ? 'restock' : 'sale', items };
    } catch (e) { toast('AI parsing unavailable: ' + e.message, 'warn'); }
    U.voice.busy = false;
  }
  if (!P.items.length) { render(); toast('I didn\'t catch a product. Try: “two bread sold”', 'warn'); speak('Sorry, I did not catch the product.'); return; }
  P.source = source; U.voice.parsed = P;
  if (set().autoApply && P.items.every(i => i.productId)) apply(); else render();
}
function apply() {
  const P = U.voice.parsed; if (!P) return; const msgs = [], alerts = []; let total = 0;
  P.items.filter(i => i.productId && +i.qty > 0).forEach(it => {
    const p = prod(it.productId); if (!p) return; const q = +Core.convertQty(+it.qty, it.unit || null, p.unit).toFixed(3);
    if (P.intent === 'sale') {
      if (q > p.stock) alerts.push(`Only ${fq(p.stock, p.unit)} of ${p.name} was in stock — please recount.`);
      const b = p.stock; p.stock = Math.max(0, +(p.stock - q).toFixed(3)); const t = +(q * p.price).toFixed(2); total += t;
      S.moves.push({ id: uid(), productId: p.id, type: 'sale', qty: q, delta: +(p.stock - b).toFixed(3), unitPrice: p.price, total: t, ts: Date.now(), source: P.source, text: P.text });
    } else { p.stock = +(p.stock + q).toFixed(3); S.moves.push({ id: uid(), productId: p.id, type: 'restock', qty: q, delta: q, ts: Date.now(), source: P.source, text: P.text }); }
    msgs.push(`${fq(q, p.unit)} ${p.name}`);
  });
  if (!msgs.length) return toast('Choose a product first', 'warn');
  if (P.intent === 'sale') { const rows = A().rows; P.items.forEach(it => { const r = rows.find(x => x.id === it.productId); if (r && (r.status === 'low' || r.status === 'out')) alerts.push(`${r.p.name} is ${r.status === 'out' ? 'out of stock' : 'running low'}: ${fq(r.p.stock, r.p.unit)} left. Reorder ${fq(r.reorderQty, r.p.unit)}.`); }); }
  save(); U.voice.parsed = null; render();
  const head = (P.intent === 'sale' ? 'Sold ' : 'Received ') + msgs.join(', ');
  toast('✅ ' + head + (total ? ' · ' + money(total) : ''), 'ok');
  [...new Set(alerts)].forEach((a, i) => setTimeout(() => toast('⚠️ ' + a, 'warn', 6500), 350 * (i + 1)));
  speak(head + '. ' + [...new Set(alerts)].join(' '));
}

