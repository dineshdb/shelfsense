---
// ShelfSense AI — one client-rendered page (owner ruling: no server
// rendering). Vite + Tailwind for the toolchain; Firebase from npm.
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <title>ShelfSense AI · Smart Retail Assistant</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛒</text></svg>">
    <script is:inline>
      // Theme before first paint: the manual Light/Dark/System choice from
      // localStorage, falling back to the OS (the Board pattern). The chrome
      // colors track the design-system canvas.
      (() => {
        const paintChrome = (dark) => {
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? "#010507" : "#ffffff");
        };
        let stored = null;
        try { stored = localStorage.getItem("shelfsense:theme"); } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = stored === "dark" || stored === "light" ? stored === "dark" : prefersDark;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        paintChrome(dark);
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          let s = null;
          try { s = localStorage.getItem("shelfsense:theme"); } catch {}
          if (s === "dark" || s === "light") return;
          document.documentElement.dataset.theme = e.matches ? "dark" : "light";
          paintChrome(e.matches);
        });
      })();
    </script>
    <script is:inline>
      /* Firebase web app config — paste from the Firebase console
         (Project settings → Your apps → Web app). Empty = local-only. */
      window.FIREBASE_CONFIG = {"projectId": "shelfsense-df2265", "appId": "1:186697947131:web:d247d9fa47daebebbc1d5e", "storageBucket": "shelfsense-df2265.firebasestorage.app", "apiKey": "AIzaSyB1Rez7wGjjZ0XgaCfQ1OB2wbZ2PfjNs_o", "authDomain": "shelfsense-df2265.firebaseapp.com", "messagingSenderId": "186697947131", "projectNumber": "186697947131", "version": "2"};
    </script>
  </head>
  <body>

<div class="shell">
  <div class="appbar">
    <div class="brand" data-a="tab" data-v="home" title="Home">
      <div class="logo" id="logo"></div>
      <div class="bt"><b id="storeName">My Grocery Store</b>
        <span class="bp"><span class="pill off" id="enginePill"><i></i>AI off</span><span class="pill off" id="cloudPill" style="display:none;cursor:pointer" data-a="tab" data-v="settings" title="Cloud Sync Settings"><i></i></span></span></div>
    </div>
    <nav class="nav">
      <button data-a="tab" data-v="scan"><span>Intake</span></button>
      <button data-a="tab" data-v="sell"><span>Sell</span></button>
      <button data-a="tab" data-v="stock"><span>Stock</span></button>
      <button data-a="tab" data-v="settings"><span>Settings</span></button>
    </nav>
  </div>
  <main id="view"></main>
</div>
<div id="sheet"></div>
<div class="toasts" id="toasts"></div>
<input type="file" id="photoIn" accept="image/*" capture="environment" multiple hidden>
<input type="file" id="importIn" accept="application/json" hidden>

    <script>
      // Firebase from npm (Vite bundles it) — exposed through the same
      // window.__firebase door the app's sync engine reads.
      import { initializeApp, getApps } from "firebase/app";
      import { getAuth, signInAnonymously, onAuthStateChanged, GoogleAuthProvider, signInWithPopup, signOut } from "firebase/auth";
      import { getFirestore, doc, getDoc, onSnapshot, runTransaction } from "firebase/firestore";
      window.__firebase = { initializeApp, getAuth, signInAnonymously, onAuthStateChanged, GoogleAuthProvider, signInWithPopup, signOut, getFirestore, doc, getDoc, onSnapshot, runTransaction };

      // Core modules & view components
      import { Core } from "../core.js";
      import { DAY, DEF, CAT, UNITS, ICONS, MAX_SCAN_IMAGES } from "../modules/constants.js";
      import { $, esc, uid, money, fq, daysTxt, ago, emoji, beep, toast, speak, fileToURL, resize, drawBoxes } from "../modules/utils.js";
      import { encodeWav, b64of } from "../modules/audio.js";
      import { S, U, set, prod, findByBarcode, save } from "../modules/state.js";
      import { aiReady, aiLabel, gemini, aiTranscribe, geminiDetect, receiptParse, fetchActiveModels, parseVoiceCommand } from "../modules/ai.js";
      import { initWebLLMEngine, unloadWebLLMEngine, deleteLocalModelStorage, isLocalEngineReady, engineState, checkWebGPUSupport } from "../modules/webllm.js";
      import { recordKhataDebit, recordKhataPayment } from "../modules/khata.js";
      import { initCloudSync, loginWithGoogle, logoutCloud, manualSyncNow, cloudState } from "../modules/cloud.js";

      import { vSetup } from "../views/setup.js";
      import { vHome } from "../views/home.js";
      import { vScan } from "../views/scan.js";
      import { vSell } from "../views/sell.js";
      import { vStock, stockList } from "../views/stock.js";
      import { vSettings } from "../views/settings.js";
      import { vSheet } from "../views/sheet.js";

/* ===== ShelfSense AI Orchestration ===== */
(() => {
const hasBarcodeDetector = typeof window !== 'undefined' && 'BarcodeDetector' in window;
const hasSpeechRec = typeof window !== 'undefined' && ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window);
let stream = null;

/* ---------- Render Coordinator ---------- */
function render() {
  const barEl = document.querySelector('.appbar');
  if (!set().setupDone) {
    if (barEl) barEl.style.display = 'none';
    $('#view').innerHTML = vSetup(U, S);
    $('#sheet').innerHTML = '';
    return;
  }
  if (barEl) barEl.style.display = '';
  $('#storeName').textContent = set().storeName;
  const pill = $('#enginePill');
  if (pill) {
    pill.className = 'pill ' + (aiReady() ? '' : 'off');
    pill.innerHTML = `<i></i>${aiReady() ? aiLabel() : 'AI off'}`;
  }

  const V = {
    home: () => vHome(S, U),
    scan: () => vScan(S, U),
    sell: () => vSell(S, U),
    stock: () => vStock(S, U),
    settings: () => vSettings(S, U)
  }[U.tab] || (() => vHome(S, U));

  $('#view').innerHTML = `<div class="view">${V()}</div>`;
  $('#sheet').innerHTML = vSheet(S, U);
  document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('on', b.dataset.v === U.tab));

  if (U.tab === 'scan') {
    const v = $('#video');
    if (v && stream) { v.srcObject = stream; v.play().catch(() => {}); }
    const img = $('#shot');
    if (img) {
      const draw = () => drawBoxes($('#shotCv'), img.naturalWidth, img.naturalHeight, U.scan.dets, U.scan.activeIdx || 0);
      img.complete ? draw() : (img.onload = draw);
    }
  }
}

const go = t => {
  if (t !== 'scan') stopCam();
  if (t !== 'sell' && U.voice.recording) stopRec();
  U.tab = t;
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

/* ---------- Barcode Hardware Loop ---------- */
let barcodeTimer = null;
function startBarcodeLoop() {
  stopBarcodeLoop();
  if (!hasBarcodeDetector) return;
  let detector;
  try {
    detector = new window.BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'qr_code', 'itf'] });
  } catch (e) {
    try { detector = new window.BarcodeDetector(); } catch (e2) { return; }
  }
  const check = async () => {
    if (!U.scan.camOn || U.scan.mode !== 'barcode' || U.scan.barcode) return;
    const v = $('#video');
    if (v && v.readyState >= 2) {
      try {
        const codes = await detector.detect(v);
        if (codes && codes.length > 0 && codes[0].rawValue) {
          onBarcodeScanned(codes[0].rawValue);
          return;
        }
      } catch (e) {}
    }
    if (U.scan.camOn && U.scan.mode === 'barcode' && !U.scan.barcode) {
      barcodeTimer = setTimeout(check, 250);
    }
  };
  barcodeTimer = setTimeout(check, 350);
}
function stopBarcodeLoop() {
  if (barcodeTimer) { clearTimeout(barcodeTimer); barcodeTimer = null; }
}
function onBarcodeScanned(code) {
  stopBarcodeLoop();
  stopCam();
  beep();
  U.scan.barcode = { code: String(code).trim() };
  render();
  const bp = findByBarcode(code);
  if (bp) toast(`🏷️ Matched: ${bp.name}`, 'ok');
  else toast(`🏷️ Read barcode: ${code} (Not in inventory)`, 'warn');
}

/* ---------- Camera & Vision Operations ---------- */
async function startCam() {
  if (!navigator.mediaDevices?.getUserMedia) {
    toast('Live camera needs HTTPS — opening photo capture instead', 'warn');
    $('#photoIn').click();
    return;
  }
  try {
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false });
    U.scan.image = null; U.scan.dets = []; U.scan.camOn = true; render();
    if (U.scan.mode === 'barcode') startBarcodeLoop();
  } catch (e) {
    toast('Camera unavailable (' + e.message + ') — opening photos', 'warn', 4500);
    $('#photoIn').click();
  }
}
function stopCam() {
  stopBarcodeLoop();
  if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
  U.scan.camOn = false;
}
function capture() {
  const v = $('#video');
  if (!v || !v.videoWidth) return toast('Camera not ready yet', 'warn');
  const k = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight));
  const c = document.createElement('canvas');
  c.width = v.videoWidth * k; c.height = v.videoHeight * k;
  c.getContext('2d').drawImage(v, 0, 0, c.width, c.height);
  const url = c.toDataURL('image/jpeg', 0.85);

  if (U.scan.mode === 'barcode') {
    stopCam();
    if (hasBarcodeDetector) {
      const im = new Image();
      im.onload = async () => {
        try {
          const det = new window.BarcodeDetector();
          const codes = await det.detect(im);
          if (codes?.length && codes[0].rawValue) {
            onBarcodeScanned(codes[0].rawValue);
            return;
          }
        } catch (e) {}
        toast('No barcode recognized in photo — try another', 'warn');
      };
      im.src = url;
    } else {
      toast('Live camera or typing barcode recommended on this browser', 'warn');
    }
    return;
  }

  const maxImages = set().maxScanImages || MAX_SCAN_IMAGES || 5;
  U.scan.images = U.scan.images || [];
  U.scan.images.push(url);
  U.scan.activeIdx = U.scan.images.length - 1;
  U.scan.image = url;
  beep();

  if (U.scan.images.length >= maxImages) {
    stopCam();
    toast(`📸 Maximum ${maxImages} photos captured! Ready to scan.`, 'ok', 3500);
    render();
  } else {
    toast(`📸 Photo #${U.scan.images.length} snapped (${U.scan.images.length}/${maxImages}) — snap more or tap "Scan"`, 'ok', 2500);
    render();
  }
}

async function analyze(imgs) {
  const sc = U.scan;
  sc.images = Array.isArray(imgs) ? imgs : [imgs];
  sc.activeIdx = 0;
  sc.image = sc.images[0] || null;
  sc.dets = [];
  sc.rcpt = null;
  sc.busy = true;

  if (sc.mode === 'rcpt') {
    if (!aiReady()) {
      sc.busy = false;
      render();
      return toast('Reading invoices needs an AI backend — Settings → AI backend', 'warn', 5000);
    }
    sc.status = 'Reading ' + sc.images.length + ' wholesale invoice page' + (sc.images.length > 1 ? 's' : '') + ' with ' + aiLabel() + '…';
    render();
    let r = null;
    try {
      r = await receiptParse(sc.images);
      sc.engine = aiLabel() + ' · wholesale invoice';
    } catch (e) {
      toast('Invoice read failed: ' + e.message + ' — try a flatter, well-lit shot', 'err', 6000);
    }
    sc.busy = false;
    sc.rcpt = r;
    const rawItems = (r ? r.items : []).map(x => ({
      name: x.name,
      category: 'Other',
      count: Math.max(0, +x.count || 1),
      unit: x.unit,
      cost: x.cost != null ? +x.cost : null,
      price: x.mrp != null ? +x.mrp : null,
      confidence: x.confidence
    }));
    const agg = Core.aggregateScanDetections(rawItems, S.products);
    sc.dets = agg.items.map(x => {
      const m = Core.matchProduct(x.name, S.products);
      const p = m.product;
      const unitCost = +x.cost || null;
      const oldCost = p?.cost || null;
      const costDiff = (oldCost && unitCost) ? +(unitCost - oldCost).toFixed(2) : null;
      const sellPrice = x.price || p?.price || (unitCost ? +(unitCost * 1.35).toFixed(2) : null);
      return {
        name: x.name,
        category: p?.category || 'Other',
        count: x.count,
        unit: UNITS.includes(x.unit) ? x.unit : 'unit',
        cost: unitCost,
        oldCost,
        costDiff,
        price: sellPrice,
        confidence: x.confidence,
        box: null,
        include: true,
        matchId: p?.id || null,
        photosCount: x.photosCount || 1
      };
    });
    render();
    if (sc.dets.length) {
      const totUnits = sc.dets.filter(d => d.include).reduce((s, d) => s + (+d.count || 0), 0);
      toast(`Parsed ${sc.dets.length} invoice line${sc.dets.length > 1 ? 's' : ''} (${totUnits} total units) across ${sc.images.length} photo${sc.images.length > 1 ? 's' : ''} — check costs & margins`, 'ok', 4000);
    } else {
      toast('No invoice lines recognized — try a closer, well-lit photo', 'warn', 5000);
    }
    return;
  }

  if (!aiReady()) {
    sc.busy = false;
    render();
    return toast('Scanning needs an AI backend — Settings → AI backend', 'warn', 5000);
  }
  sc.status = `Scanning ${sc.images.length} photo${sc.images.length > 1 ? 's in parallel' : ''} with ${aiLabel()}…`;
  render();

  let allDetections = [];
  try {
    // Dispatch individual detection requests simultaneously in parallel
    const promises = sc.images.map((img, idx) =>
      geminiDetect([img])
        .then(dets => (dets || []).map(d => ({ ...d, imageIdx: idx })))
        .catch(err => {
          console.warn(`Detection on photo #${idx + 1} failed:`, err);
          return [];
        })
    );
    const results = await Promise.all(promises);
    allDetections = results.flat();
    sc.engine = aiLabel();
  } catch (e) {
    toast(e.message, 'err', 5000);
  }
  sc.busy = false;
  const agg = Core.aggregateScanDetections(allDetections, S.products);
  sc.dets = agg.items.map(x => {
    const m = Core.matchProduct(x.name, S.products);
    return {
      name: x.name,
      category: CAT[x.category] ? x.category : (m.product?.category || 'Other'),
      count: x.count,
      unit: UNITS.includes(x.unit) ? x.unit : (m.product?.unit || 'unit'),
      price: x.price || (m.product ? m.product.price : null),
      confidence: x.confidence,
      box: x.box,
      boxes: x.boxes || {},
      imageIdx: x.imageIdx,
      include: true,
      matchId: m.product?.id || null,
      photosCount: x.photosCount || 1
    };
  });
  render();
  if (sc.dets.length) {
    const totUnits = sc.dets.filter(d => d.include).reduce((s, d) => s + (+d.count || 0), 0);
    toast(`Found ${sc.dets.length} product type${sc.dets.length > 1 ? 's' : ''} (${totUnits} total units) across ${sc.images.length} photo${sc.images.length > 1 ? 's' : ''}`, 'ok', 4000);
  } else {
    toast('No products recognized — try a closer, well-lit photo', 'warn', 5000);
  }
}

function commit(mode) {
  const rcpt = U.scan.mode === 'rcpt';
  const voice = U.scan.mode === 'voice';
  if (rcpt || voice) mode = 'add';
  const src = rcpt ? 'inward_bill' : voice ? 'voice_intake' : 'scan';
  const supplier = rcpt && U.scan.rcpt?.store ? U.scan.rcpt.store : voice ? 'Voice Intake' : '';
  const invNo = rcpt && U.scan.rcpt?.invoiceNo ? U.scan.rcpt.invoiceNo : '';
  let a = 0, u = 0;
  const logged = [];

  U.scan.dets.filter(d => d.include && d.name.trim()).forEach(d => {
    const q = +d.count || 0;
    let p = d.matchId && prod(d.matchId);
    if (p) {
      const b = p.stock;
      p.stock = mode === 'set' ? q : +(p.stock + q).toFixed(3);
      if (d.cost != null && d.cost > 0) p.cost = +d.cost;
      if (d.price != null && d.price > 0) p.price = +d.price;
      else if (rcpt && d.cost && !p.price) p.price = +(d.cost * 1.35).toFixed(2);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: mode === 'set' ? 'adjust' : 'restock',
        qty: +(p.stock - b).toFixed(3),
        delta: +(p.stock - b).toFixed(3),
        ts: Date.now(),
        source: src,
        supplier,
        invoiceNo: invNo
      });
      u++;
      logged.push({ name: p.name, qty: q, unit: p.unit });
    } else {
      const sellPrice = (d.price != null && d.price > 0) ? +d.price : (d.cost ? +(d.cost * 1.35).toFixed(2) : 0);
      p = {
        id: uid(),
        name: d.name.trim(),
        barcode: '',
        aliases: [],
        category: d.category || 'Other',
        unit: d.unit,
        stock: q,
        price: sellPrice,
        cost: +d.cost || 0,
        minStock: null,
        createdAt: Date.now()
      };
      S.products.push(p);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'restock',
        qty: q,
        delta: q,
        ts: Date.now(),
        source: src,
        supplier,
        invoiceNo: invNo
      });
      a++;
      logged.push({ name: p.name, qty: q, unit: p.unit });
    }
  });

  save();
  const summaryMsg = `${rcpt ? '📦 Inward stock logged' : voice ? '🎙️ Voice intake stock logged' : '✅ Inventory updated'}: ${a} new, ${u} updated`;
  toast(summaryMsg, 'ok');

  if (rcpt && supplier) {
    const waText = encodeURIComponent(`📦 *Inward Acknowledgment — ${set().storeName}*\nSupplier: ${supplier}${invNo ? ` (Inv #${invNo})` : ''}\nItems received:\n` + logged.map(it => `• ${fq(it.qty, it.unit)} ${it.name}`).join('\n') + `\n\nStock updated via ShelfSense AI.`);
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'toast ok';
      el.innerHTML = `<span>Delivery recorded. <a href="https://wa.me/?text=${waText}" target="_blank" style="color:#fff;font-weight:700;text-decoration:underline">📲 WhatsApp Supplier</a></span>`;
      $('#toasts').appendChild(el);
      setTimeout(() => el.remove(), 7000);
    }, 400);
  }

  U.scan.image = null; U.scan.images = []; U.scan.activeIdx = 0; U.scan.dets = []; U.scan.rcpt = null; U.scan.voiceText = '';
  go('stock');
}

async function intakeVoiceCommand(text) {
  text = (text || '').trim();
  if (!text) return;
  const sc = U.scan;
  sc.voiceText = text;
  sc.busy = true;
  sc.status = `Extracting products with ${aiLabel()}…`;
  render();

  try {
    let rawItems = [];
    if (aiReady()) {
      try {
        const parsed = await parseVoiceCommand(text, S.products.map(p => p.name));
        rawItems = (parsed && parsed.items ? parsed.items : []).map(it => {
          const m = Core.matchProduct(it.product || it.heard || it.query || '', S.products);
          const p = m.product;
          const cleanName = p ? p.name : (it.product || it.heard || it.query || 'Product');
          const unitCost = it.cost != null && it.cost > 0 ? +it.cost : (p?.cost || null);
          const sellPrice = it.price != null && it.price > 0 ? +it.price : (p?.price || (unitCost ? +(unitCost * 1.35).toFixed(2) : null));
          return {
            name: cleanName,
            category: p?.category || 'Other',
            count: Math.max(1, +it.qty || 1),
            unit: UNITS.includes(it.unit) ? it.unit : (p?.unit || 'unit'),
            cost: unitCost,
            price: sellPrice,
            confidence: it.confidence || 0.95,
            include: true,
            matchId: p?.id || null,
            photosCount: 1
          };
        });
      } catch (e) {
        console.warn('parseVoiceCommand error, falling back to local intake:', e);
      }
    }

    if (!rawItems.length) {
      rawItems = Core.parseVoiceIntake(text, S.products);
    }

    if (rawItems.length) {
      sc.engine = aiLabel() + ' · voice intake';
      const agg = Core.aggregateScanDetections([...sc.dets, ...rawItems], S.products);
      sc.dets = agg.items.map(x => {
        const m = Core.matchProduct(x.name, S.products);
        const p = m.product;
        const unitCost = +x.cost || null;
        const oldCost = p?.cost || null;
        const costDiff = (oldCost && unitCost) ? +(unitCost - oldCost).toFixed(2) : null;
        return {
          name: x.name,
          category: CAT[x.category] ? x.category : (p?.category || 'Other'),
          count: x.count,
          unit: UNITS.includes(x.unit) ? x.unit : (p?.unit || 'unit'),
          cost: unitCost,
          oldCost,
          costDiff,
          price: x.price || p?.price || (unitCost ? +(unitCost * 1.35).toFixed(2) : null),
          confidence: x.confidence,
          box: null,
          include: true,
          matchId: p?.id || null,
          photosCount: 1
        };
      });
      sc.busy = false;
      render();
      const totUnits = sc.dets.filter(d => d.include).reduce((s, d) => s + (+d.count || 0), 0);
      toast(`🎙️ Added ${rawItems.length} product line${rawItems.length > 1 ? 's' : ''} (${totUnits} total units)!`, 'ok', 3500);
    } else {
      sc.busy = false;
      render();
      toast('Could not recognize product names or quantities — try speaking closer or typing', 'warn', 4500);
    }
  } catch (err) {
    sc.busy = false;
    render();
    toast('Voice intake error: ' + err.message, 'err', 4500);
  }
}

/* ---------- Voice Operations ---------- */
let latestRecognizedSpeech = '';

async function listen() {
  if (U.voice.recording) return stopRec();
  if (!hasSpeechRec && (set().voiceEngine === 'gemma' || !set().apiKey)) {
    toast('🦊 Firefox does not support in-browser live speech. Please type your command below, or use Google Chrome / Microsoft Edge for instant microphone recording!', 'warn', 6000);
    const typedEl = $('#typed');
    if (typedEl) { typedEl.focus(); }
    return;
  }
  if (!aiReady() && !hasSpeechRec && !set().apiKey) return toast('Voice needs an AI backend or Chrome/Edge — Settings → AI backend', 'warn', 5000);
  if (!navigator.mediaDevices?.getUserMedia && !hasSpeechRec) return toast('Microphone needs HTTPS or Chrome/Edge — type the command instead', 'warn', 5000);
  startRec();
}

async function startRec() {
  if (!S.products.length) toast('Tip: add products first (Scan or Load demo)', 'warn');
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  latestRecognizedSpeech = '';
  if (SpeechRec) {
    if (U.voice.rec?.nativeRec) {
      try { U.voice.rec.nativeRec.abort(); } catch (e) {}
      U.voice.rec = null;
    }
    try {
      const rec = new SpeechRec();
      rec.continuous = true;
      rec.interimResults = true;
      rec.lang = set().lang || 'en-US';
      U.voice.transcript = '';
      U.voice.recording = true;
      render();
      rec.onresult = e => {
        let interim = '';
        let finalConcat = '';
        for (let i = e.resultIndex; i < e.results.length; ++i) {
          const res = e.results[i];
          const phrase = res[0]?.transcript || '';
          if (res.isFinal) {
            finalConcat += ' ' + phrase;
          } else {
            interim += ' ' + phrase;
          }
        }
        finalConcat = finalConcat.trim();
        interim = interim.trim();
        if (finalConcat) {
          latestRecognizedSpeech = finalConcat;
          U.voice.transcript = finalConcat;
          render();
          command(finalConcat, 'voice');
        } else if (interim) {
          latestRecognizedSpeech = interim;
          const el = $('#trans');
          if (el) { el.textContent = '“' + interim + '”'; el.classList.remove('ph2'); }
        }
      };
      rec.onend = () => {
        U.voice.rec = null;
        U.voice.recording = false;
        const pending = (latestRecognizedSpeech || '').trim();
        latestRecognizedSpeech = '';
        if (pending) {
          U.voice.transcript = pending;
          command(pending, 'voice');
        }
        if (U.voice.handsFree && U.tab === 'sell') {
          setTimeout(() => {
            if (U.voice.handsFree && !U.voice.recording && U.tab === 'sell') {
              startRec();
            }
          }, 300);
        } else {
          render();
        }
      };
      rec.onerror = e => {
        console.warn('Native speech recognition event:', e.error);
        if (e.error === 'not-allowed') {
          U.voice.handsFree = false;
          U.voice.recording = false;
          U.voice.rec = null;
          toast('🎙️ Microphone access denied — click the 🔒 icon in Chrome address bar to Allow microphone', 'err', 5000);
          render();
        } else if (e.error === 'audio-capture') {
          U.voice.recording = false;
          U.voice.rec = null;
          toast('🎙️ Microphone capture failed — check if mic is plugged in and unmuted in Windows sound settings', 'err', 5000);
          render();
        } else if (e.error === 'no-speech') {
          if (!U.voice.handsFree) {
            U.voice.recording = false;
            U.voice.rec = null;
            toast('🎙️ No speech detected — please speak closer to the mic or type command below', 'warn', 4000);
            render();
          }
        } else if (e.error === 'network') {
          U.voice.recording = false;
          U.voice.rec = null;
          toast('🎙️ Speech service network error — check connection or type command below', 'err', 4000);
          render();
        }
      };
      U.voice.rec = { nativeRec: rec };
      rec.start();
      return;
    } catch (e) {
      console.warn('SpeechRec failed, falling back:', e);
    }
  }
  startRecAudioContext();
}

async function startRecAudioContext() {
  let stream;
  try {
    stream = await navigator.mediaDevices.getUserMedia({ audio: true });
  } catch (e) {
    return toast('Mic unavailable: ' + e.message, 'err', 5000);
  }
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const src = ctx.createMediaStreamSource(stream);
  const proc = ctx.createScriptProcessor(4096, 1, 1);
  const chunks = [];
  proc.onaudioprocess = e => {
    if (U.voice.recording) chunks.push(new Float32Array(e.inputBuffer.getChannelData(0)));
  };
  src.connect(proc);
  proc.connect(ctx.destination);
  U.voice.rec = { stream, ctx, src, proc, chunks };
  U.voice.recording = true;
  U.voice.transcript = '';
  render();
  U.voice.recCap = setTimeout(() => { if (U.voice.recording) stopRec(); }, 30000);
}

async function stopRec() {
  U.voice.handsFree = false;
  const r = U.voice.rec;
  if (!r) return;
  if (r.nativeRec) {
    const pending = (latestRecognizedSpeech || '').trim();
    latestRecognizedSpeech = '';
    U.voice.recording = false;
    U.voice.rec = null;
    try { r.nativeRec.stop(); } catch (e) {}
    render();
    if (pending) {
      U.voice.transcript = pending;
      render();
      command(pending, 'voice');
    }
    return;
  }
  clearTimeout(U.voice.recCap);
  U.voice.recording = false;
  U.voice.busy = true;
  render();
  try { r.proc.disconnect(); r.src.disconnect(); } catch (e) {}
  r.stream.getTracks().forEach(t => t.stop());
  const wav = encodeWav(r.chunks, r.ctx.sampleRate);
  try { r.ctx.close(); } catch (e) {}
  U.voice.rec = null;
  if (wav.length < 6000) {
    U.voice.busy = false;
    render();
    return toast('No speech caught — tap the mic and speak', 'warn');
  }
  try {
    const text = await aiTranscribe(b64of(wav), set().lang);
    U.voice.busy = false;
    if (!text) {
      render();
      return toast('Nothing heard — try again a little closer to the mic', 'warn', 5000);
    }
    const el = $('#trans');
    if (el) { el.textContent = '“' + text + '”'; el.classList.remove('ph2'); }
    command(text, 'voice');
  } catch (e) {
    U.voice.busy = false;
    render();
    toast('Transcription failed: ' + e.message + ' — you can type the command', 'err', 6000);
  }
}

let saveCountdownTimer = null;
let saveCountdownSecs = 3;

function cancelSaveCountdown() {
  if (saveCountdownTimer) {
    clearInterval(saveCountdownTimer);
    saveCountdownTimer = null;
  }
  const popup = document.querySelector('#saveCountdownPopup');
  if (popup) popup.remove();
  toast('Auto-save cancelled', 'warn', 2000);
}

function confirmSaveNow() {
  if (saveCountdownTimer) {
    clearInterval(saveCountdownTimer);
    saveCountdownTimer = null;
  }
  const popup = document.querySelector('#saveCountdownPopup');
  if (popup) popup.remove();

  billApply(false);

  U.voice.bill = [];
  U.voice.customer = '';
  U.voice.statusMsg = '🎙️ Order saved! Ready for next customer...';
  render();

  if (hasSpeechRec && !U.voice.recording && U.voice.handsFree) {
    setTimeout(() => {
      startRec();
    }, 400);
  }
}

function startSaveCountdown() {
  cancelSaveCountdown();
  const inc = U.voice.bill.filter(b => b.include);
  const total = inc.reduce((sum, b) => {
    if (b.intent !== 'sale') return sum;
    const pr = prod(b.productId);
    if (!pr) return sum;
    const q = +Core.convertQty(+b.qty, b.unit || null, pr.unit).toFixed(3);
    return sum + q * pr.price;
  }, 0);

  saveCountdownSecs = 3;
  const overlay = document.createElement('div');
  overlay.className = 'save-popup-overlay';
  overlay.id = 'saveCountdownPopup';
  overlay.innerHTML = `
    <div class="save-popup-card">
      <div class="save-popup-icon">💾</div>
      <h3>Saving Order · ${money(total, set().currency)}</h3>
      <p>Auto-saving and starting next order in <b><span id="countdownSecs">3</span>s</b>...</p>
      <div class="countdown-bar"><div class="countdown-fill" id="countdownFill" style="width:100%"></div></div>
      <div class="g2 mt">
        <button class="btn pri" data-a="confirmSaveNow">⚡ Save Now</button>
        <button class="btn ghost" data-a="cancelSaveCountdown">✕ Cancel</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);

  setTimeout(() => {
    const fill = document.querySelector('#countdownFill');
    if (fill) fill.style.width = '0%';
  }, 40);

  saveCountdownTimer = setInterval(() => {
    saveCountdownSecs--;
    const num = document.querySelector('#countdownSecs');
    if (num) num.textContent = String(saveCountdownSecs);
    if (saveCountdownSecs <= 0) {
      confirmSaveNow();
    }
  }, 1000);
}

function localCommandParse(text, products) {
  return Core.localCommandParse(text, products);
}

async function command(text, source) {
  U.voice.transcript = text;
  const rawTrimmed = (text || '').trim();
  const norm = rawTrimmed.toLowerCase().replace(/^[.,!?;:]+|[.,!?;:]+$/g, '');

  const handsFreeEnabled = !!set().handsFreeEnabled;

  // 1. Meta-command: "Take order" / "Accept order" / "Bill shuru karo" (only active when Hands-Free flag is ON)
  const isTakeOrder = handsFreeEnabled && /(?:take|accept|start|create|make|receive|begin|get)\s*(?:an?|the|my|this|new)?\s*order\b|(?:bill|order)\s*(?:banao|lo|le\s*lo|shuru|karo|start)|(?:naya|new)\s*(?:bill|order)|(?:take|start|accept)\s*order|टेक\s*ऑर्डर|बिल\s*बनाओ|ऑर्डर\s*लो|ऑर्डर\s*शुरू|नया\s*बिल/i.test(norm);
  if (isTakeOrder) {
    U.voice.transcript = '';
    U.voice.handsFree = true;
    U.voice.bill = [];
    U.voice.customer = '';
    U.voice.statusMsg = '🎙️ Taking order... speak items (say "Done" or "Ho gaya" when finished)';
    toast('🎙️ "Take order" active — speak items freely!', 'ok', 3500);
    render();

    const remainder = norm.replace(/.*?(?:(?:take|accept|start|create|make|receive|begin|get)\s*(?:an?|the|my|this|new)?\s*order|(?:bill|order)\s*(?:banao|lo|le\s*lo|shuru|karo|start)|(?:naya|new)\s*(?:bill|order)|(?:take|start|accept)\s*order|टेक\s*ऑर्डर|बिल\s*बनाओ|ऑर्डर\s*लो|ऑर्डर\s*शुरू|नया\s*बिल)[,\s]*(?:for\s*)?/i, '').trim();

    if (!U.voice.recording || !U.voice.rec?.nativeRec?.continuous) {
      if (U.voice.rec?.nativeRec) {
        try { U.voice.rec.nativeRec.abort(); } catch (e) {}
        U.voice.rec = null;
      }
      setTimeout(() => startRec(), 150);
    }

    if (remainder && remainder.length > 2) {
      setTimeout(() => command(remainder, source), 300);
    }
    return;
  }

  // 2. Meta-command: "Done" / "Ho gaya" / "Bas" / "Complete"
  const isDone = handsFreeEnabled && /(?:\bdone\b|\ball\s*done\b|\bthat'?s\s*all\b|\bthat\s*is\s*all\b|\bfinish(?:ed)?\b|\bcomplete(?:d)?\b|\bho\s*gaya\b|\bhogaya\b|\bbas\b|\bbaas\b|\bitna\s*hi\b|\bkhatam\b|\bstop\s*(?:order)?\b|हो\s*गया|बस|खत्म|पूरा)/i.test(norm);
  if (isDone) {
    U.voice.transcript = '';
    if (!U.voice.bill.length) {
      U.voice.statusMsg = 'No items added yet. Speak items or say "Cancel".';
      render();
      toast('No items on bill yet', 'warn');
      return;
    }
    U.voice.statusMsg = '✅ Order complete! Say "Next" to save & take next order, or "Cancel" to abort.';
    render();
    toast('✅ Order complete! Say "Next" to save.', 'ok', 3500);
    return;
  }

  // 3. Meta-command: "Next" / "Agla" / "Naya bill" / "Save"
  const isNext = handsFreeEnabled && /(?:\bnext(?:\s*(?:order|customer|bill))?\b|\bagla(?:\s*customer)?\b|\bagle\b|\bsave(?:\s*(?:order|bill))?\b|\bcheckout\b|\bcomplete\s*sale\b|अगला|अगले|सेव)/i.test(norm);
  if (isNext) {
    U.voice.transcript = '';
    if (!U.voice.bill.length) {
      toast('No active order to save. Say "Take order" to start.', 'warn');
      return;
    }
    startSaveCountdown();
    return;
  }

  // 4. Meta-command: "Cancel" / "Radd" / "Discard"
  const isCancel = handsFreeEnabled && /(?:\bcancel(?:\s*(?:order|bill))?\b|\bclear(?:\s*bill)?\b|\bradd\b|\bhatao\b|\bdiscard\b|\babort\b|कैंसिल|रद्द|हटाओ)/i.test(norm);
  if (isCancel) {
    U.voice.transcript = '';
    if (saveCountdownTimer) {
      cancelSaveCountdown();
      return;
    }
    U.voice.bill = [];
    U.voice.customer = '';
    U.voice.statusMsg = '';
    render();
    toast('🚫 Order cancelled / cleared', 'warn', 2500);
    return;
  }

  if (!S.products.length) {
    demo();
    toast('✨ Store catalog initialized — continuing with order!', 'ok', 2500);
  }
  U.voice.busy = true;
  render();
  let P;
  if (aiReady()) {
    try {
      const r = await parseVoiceCommand(text, S.products.map(p => p.name));
      P = Core.normalizeModelParse(r, text, S.products);
    } catch (e) {
      console.warn('AI parse shifted/failed:', e.message);
      const isGemma = (set().voiceEngine === 'gemma');
      if (isGemma) {
        toast('⚡ Gemma ($0): Using Built-in Offline Engine ($0 Cost, No quota used)', 'ok', 3000);
      } else if (e.message && (e.message.includes('quota') || e.message.includes('429'))) {
        toast('⚠️ ' + e.message, 'warn', 4500);
      }
      P = localCommandParse(text, S.products);
    }
  } else {
    P = localCommandParse(text, S.products);
  }
  // FAIL-SAFE: If the AI model returned 0 items, immediately fall back to deterministic local parser!
  if (!P || !P.items || !P.items.length) {
    const fallbackP = localCommandParse(text, S.products);
    if (fallbackP && fallbackP.items && fallbackP.items.length) {
      P = fallbackP;
    }
  }
  U.voice.busy = false;
  if (!P.items.length) {
    render();
    toast("I didn't catch a product. Try: “two bread sold”", 'warn');
    return;
  }
  if (P.customer) U.voice.customer = P.customer;
  if (P.paymentMode) U.voice.paymentMode = P.paymentMode;
  P.items.forEach(it => U.voice.bill.push({
    id: uid(),
    text,
    intent: it.intent || P.intent,
    query: it.query,
    qty: it.qty,
    unit: it.unit,
    productId: it.productId,
    include: true,
    source
  }));
  U.voice.statusMsg = `🧾 Added ${P.items.length} line${P.items.length > 1 ? 's' : ''}. Speak more items or say "Done / Ho gaya".`;
  render();
  toast('🧾 ' + P.items.length + ' line' + (P.items.length > 1 ? 's' : '') + (P.customer ? ` for ${P.customer}` : '') + (P.paymentMode === 'khata' ? ' (📖 Khata)' : ''), 'ok', 2600);
}

function billApply(print) {
  const custInput = ($('#billCustomer')?.value || '').trim();
  if (custInput) U.voice.customer = custInput;
  const cname = U.voice.customer || 'Walk-in Customer';
  const isKhata = U.voice.paymentMode === 'khata';
  const rows = U.voice.bill.filter(b => b.include);
  const ok = rows.filter(b => b.productId && prod(b.productId) && +b.qty > 0);
  if (!ok.length) return toast('Nothing to record — pick a product for at least one line', 'warn');

  const msgs = [], alerts = [];
  let total = 0;
  ok.forEach(b => {
    const p = prod(b.productId);
    const q = +Core.convertQty(+b.qty, b.unit || null, p.unit).toFixed(3);
    if (b.intent === 'sale') {
      const over = q > p.stock;
      if (over) alerts.push(`Only ${fq(p.stock, p.unit)} of ${p.name} was in stock — please recount.`);
      const st = p.stock;
      p.stock = Math.max(0, +(p.stock - q).toFixed(3));
      const t = +(q * p.price).toFixed(2);
      total += t;
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'sale',
        qty: q,
        delta: +(p.stock - st).toFixed(3),
        unitPrice: p.price,
        total: t,
        ts: Date.now(),
        source: b.source || 'bill',
        customer: cname,
        paymentMode: U.voice.paymentMode,
        text: over ? [b.text, 'oversold'].filter(Boolean).join(' — ') : b.text
      });
    } else {
      const st = p.stock;
      p.stock = +(p.stock + q).toFixed(3);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'restock',
        qty: q,
        delta: +(p.stock - st).toFixed(3),
        ts: Date.now(),
        source: b.source || 'bill',
        text: b.text
      });
    }
    msgs.push({
      name: p.name,
      qty: q,
      unit: p.unit,
      price: p.price,
      line: b.intent === 'sale' ? +(q * p.price).toFixed(2) : null,
      intent: b.intent
    });
  });

  if (isKhata && total > 0) {
    recordKhataDebit(S.khata, cname, total, msgs.map(m => `${fq(m.qty, m.unit)} ${m.name}`));
  }

  if (ok.some(b => b.intent === 'sale')) {
    const ar = Core.analyze(S.products, S.moves, set()).rows;
    ok.forEach(b => {
      const r = ar.find(x => x.id === b.productId);
      if (r && (r.status === 'low' || r.status === 'out')) {
        alerts.push(`${r.p.name} is ${r.status === 'out' ? 'out of stock' : 'running low'}: ${fq(r.p.stock, r.p.unit)} left. Reorder ${fq(r.reorderQty, r.p.unit)}.`);
      }
    });
  }

  save();
  if (print) printBill(msgs, total);

  const nMiss = rows.filter(b => !b.productId || !prod(b.productId)).length;
  const head = (isKhata ? `📖 ${cname} Khata: ` : 'Bill recorded: ') + msgs.map(m => `${fq(m.qty, m.unit)} ${m.name}`).join(', ');
  toast('✅ ' + head + (total ? ' · ' + money(total, set().currency) : ''), 'ok');

  if (isKhata && total > 0) {
    const outstanding = S.khata[cname]?.balance || total;
    const waBill = encodeURIComponent(`🧾 *Bill Receipt — ${set().storeName}*\nCustomer: ${cname}\nDate: ${new Date().toLocaleDateString()}\n\n` + msgs.map(m => `• ${fq(m.qty, m.unit)} ${m.name}: ${money(m.line, set().currency)}`).join('\n') + `\n\n*Total:* ${money(total, set().currency)}\n*Payment:* 📖 Khata (Store Credit)\n*Outstanding Balance:* ${money(outstanding, set().currency)}\n\nThank you!`);
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'toast ok';
      el.innerHTML = `<span>📖 Added to ${cname}'s tab. <a href="https://wa.me/?text=${waBill}" target="_blank" style="color:#fff;font-weight:700;text-decoration:underline">📲 WhatsApp Receipt</a></span>`;
      $('#toasts').appendChild(el);
      setTimeout(() => el.remove(), 7000);
    }, 400);
  }

  U.voice.bill = [];
  U.voice.customer = '';
  U.voice.paymentMode = 'cash';
  render();

  if (nMiss) setTimeout(() => toast(`⚠️ ${nMiss} item${nMiss > 1 ? 's' : ''} not in inventory — skipped. Add them in Stock first, then resell.`, 'warn', 7000), 350);
  [...new Set(alerts)].forEach((a, i) => setTimeout(() => toast('⚠️ ' + a, 'warn', 6500), 350 * (i + 1 + (nMiss ? 1 : 0))));
  speak(head + '. ' + [...new Set(alerts)].join(' '), set());
}

