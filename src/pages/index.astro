    ['Coca-Cola 600ml', 'Beverages', 'unit', 40, 1.00, .65, 6.5, ['coke', 'coca cola', 'soda', 'coca']], ['Bananas', 'Fruits', 'kg', 3, .70, .40, 3.1, ['banana', 'banano']],
    ['Tomatoes', 'Vegetables', 'kg', 7, 1.60, 1.10, 1.5, ['tomato', 'tomate']], ['Pasta 500g', 'Pantry', 'pack', 26, .90, .60, 1.2, ['pasta', 'spaghetti']],
    ['Ground Coffee 250g', 'Pantry', 'pack', 10, 4.50, 3.20, .45, ['coffee', 'cafe']], ['Black Beans', 'Grains', 'kg', 16, 1.80, 1.30, 1.1, ['beans', 'frijoles']],
    ['Bar Soap', 'Personal Care', 'unit', 34, .80, .50, .15, ['soap', 'jabon']], ['Salt 1kg', 'Pantry', 'unit', 22, .50, .30, .06, ['salt', 'sal']]];
