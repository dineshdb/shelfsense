function billApply(print) {
  const rows = U.voice.bill.filter(b => b.include);
  const ok = rows.filter(b => b.productId && prod(b.productId) && +b.qty > 0);
  if (!ok.length) return toast('Nothing to record — pick a product for at least one line', 'warn');
  const msgs = [], alerts = []; let total = 0;
  ok.forEach(b => {
    const p = prod(b.productId); const q = +Core.convertQty(+b.qty, b.unit || null, p.unit).toFixed(3);
    if (b.intent === 'sale') {
      const over = q > p.stock;
      if (over) alerts.push(`Only ${fq(p.stock, p.unit)} of ${p.name} was in stock — please recount.`);
      const st = p.stock; p.stock = Math.max(0, +(p.stock - q).toFixed(3)); const t = +(q * p.price).toFixed(2); total += t;
      S.moves.push({ id: uid(), productId: p.id, type: 'sale', qty: q, delta: +(p.stock - st).toFixed(3), unitPrice: p.price, total: t, ts: Date.now(), source: b.source || 'bill',
        text: over ? [b.text, 'oversold'].filter(Boolean).join(' — ') : b.text }); // the ledger keeps the oversell auditable
    } else { const st = p.stock; p.stock = +(p.stock + q).toFixed(3); S.moves.push({ id: uid(), productId: p.id, type: 'restock', qty: q, delta: +(p.stock - st).toFixed(3), ts: Date.now(), source: b.source || 'bill', text: b.text }); }
    msgs.push({ name: p.name, qty: q, unit: p.unit, price: p.price, line: b.intent === 'sale' ? +(q * p.price).toFixed(2) : null, intent: b.intent });
  });
  if (ok.some(b => b.intent === 'sale')) { const ar = A().rows; ok.forEach(b => { const r = ar.find(x => x.id === b.productId); if (r && (r.status === 'low' || r.status === 'out')) alerts.push(`${r.p.name} is ${r.status === 'out' ? 'out of stock' : 'running low'}: ${fq(r.p.stock, r.p.unit)} left. Reorder ${fq(r.reorderQty, r.p.unit)}.`); }); }
  save();
  if (print) printBill(msgs, total);
  U.voice.bill = []; render();
  const nMiss = rows.filter(b => !b.productId || !prod(b.productId)).length;
  const head = 'Bill recorded: ' + msgs.map(m => `${fq(m.qty, m.unit)} ${m.name}`).join(', ');
  toast('✅ ' + head + (total ? ' · ' + money(total) : ''), 'ok');
  if (nMiss) setTimeout(() => toast(`⚠️ ${nMiss} item${nMiss > 1 ? 's' : ''} not in inventory — skipped. Add them in Stock first, then resell.`, 'warn', 7000), 350);
  [...new Set(alerts)].forEach((a, i) => setTimeout(() => toast('⚠️ ' + a, 'warn', 6500), 350 * (i + 1 + (nMiss ? 1 : 0))));
  speak(head + '. ' + [...new Set(alerts)].join(' '));
}
