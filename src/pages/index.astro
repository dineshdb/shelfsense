  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20.5" r="1.3"/><circle cx="17" cy="20.5" r="1.3"/></svg>',
  search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>'
};

/* ---------- state ---------- */
let saved = {}; try { saved = JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) {}
const S = { products: saved.products || [], moves: saved.moves || [], settings: Object.assign({}, DEF, saved.settings || {}) };
const U = { tab: 'home', scan: { image: null, dets: [], busy: false, status: '', camOn: false, engine: '', mode: 'shelf', rcpt: null },
  voice: { transcript: '', busy: false, bill: [], recording: false, rec: null }, inv: { q: '', cat: 'All', sort: 'name' }, ai: { busy: false, text: '' }, setup: { mode: 'gemini', busy: false, msg: '' }, edit: null };
let stream = null;
const save = (cloud = true) => {
  S.savedAt = Date.now();
  try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) { toast('Storage full — export your data', 'err'); }
  if (cloud && window.__cloudPut) window.__cloudPut();
};

/* ---------- helpers ---------- */
const set = () => S.settings;
const money = n => esc(set().currency) + (Number(n) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const fq = (q, unit, dec) => {
  if (!isFinite(q)) return '–';
  const d = dec !== undefined ? dec : (unit === 'kg' || unit === 'L' ? 2 : 1);
  return (Math.round(q * 10 ** d) / 10 ** d).toLocaleString(undefined, { maximumFractionDigits: d }) + (unit && unit !== 'unit' ? ' ' + unit : '');
};
const daysTxt = d => !isFinite(d) ? 'no recent sales' : d < 1 ? '< 1 day left' : '~' + Math.round(d) + ' days left';
const ago = ts => { const s = (Date.now() - ts) / 1000; return s < 60 ? 'just now' : s < 3600 ? Math.round(s / 60) + ' min ago' : s < 86400 ? Math.round(s / 3600) + ' h ago' : Math.round(s / 86400) + ' d ago'; };
const emoji = p => { const n = Core.strip(p.name); for (const [re, e] of NAME_EMOJI) if (re.test(n)) return e; return CAT[p.category] || '📦'; };
const prod = id => S.products.find(p => p.id === id);
const color = s => ({ ok: 'var(--ok)', low: 'var(--warn)', out: 'var(--bad)', slow: 'var(--chart-4)' }[s]);
function toast(msg, type = '', ms = 3200) {
  const el = document.createElement('div'); el.className = 'toast ' + type; el.textContent = msg;
  $('#toasts').appendChild(el); setTimeout(() => el.remove(), ms);
}
function speak(msg) {
  if (!set().speak || !window.speechSynthesis) return;
  try { speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(msg); u.lang = set().lang; u.rate = 1.05; speechSynthesis.speak(u); } catch (e) {}
}
const fileToURL = f => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(f); });
const resize = (src, max = 1280) => new Promise((res, rej) => { const im = new Image(); im.onload = () => { const k = Math.min(1, max / Math.max(im.width, im.height)); const c = document.createElement('canvas'); c.width = Math.round(im.width * k); c.height = Math.round(im.height * k); c.getContext('2d').drawImage(im, 0, 0, c.width, c.height); res(c.toDataURL('image/jpeg', .85)); }; im.onerror = () => rej(new Error('Could not read image')); im.src = src; });
function drawBoxes(cv, w, h, dets) {
  cv.width = w; cv.height = h; const x = cv.getContext('2d'); x.clearRect(0, 0, w, h);
  const lw = Math.max(2, w / 260), fs = Math.max(14, w / 42); x.font = `600 ${fs}px Inter,system-ui,sans-serif`;
  // the Qreta chart ramp (design-system chart tokens, literal for canvas)
  const PAL = [
    ['oklch(0.596 0.145 163.225)', 'oklch(0.596 0.145 163.225 / 0.14)'],
    ['oklch(0.52 0.105 223.128)', 'oklch(0.52 0.105 223.128 / 0.14)'],
    ['oklch(0.508 0.118 165.612)', 'oklch(0.508 0.118 165.612 / 0.14)'],
    ['oklch(0.72 0.14 75)', 'oklch(0.72 0.14 75 / 0.16)'],
    ['oklch(0.432 0.095 166.913)', 'oklch(0.432 0.095 166.913 / 0.14)'],
    ['oklch(0.577 0.245 27.325)', 'oklch(0.577 0.245 27.325 / 0.12)'],
    ['oklch(0.56 0.021 213.5)', 'oklch(0.56 0.021 213.5 / 0.16)'],
  ];
  dets.forEach((d, i) => {
    if (!d.box || d.box.length !== 4 || d.include === false) return;
    const [y0, x0, y1, x1] = d.box.map(Number), X = x0 / 1000 * w, Y = y0 / 1000 * h, W = (x1 - x0) / 1000 * w, H = (y1 - y0) / 1000 * h;
    const col = PAL[i % PAL.length];
    x.strokeStyle = col[0]; x.lineWidth = lw; x.beginPath(); x.roundRect ? x.roundRect(X, Y, W, H, lw * 3) : x.rect(X, Y, W, H); x.stroke();
    x.fillStyle = col[1]; x.fill();
    const label = d.name + (d.count > 1 ? ' ×' + d.count : ''), tw = x.measureText(label).width + 14, ty = Math.max(0, Y - fs - 10);
    x.fillStyle = col[0]; x.fillRect(X, ty, tw, fs + 10); x.fillStyle = '#fff'; x.fillText(label, X + 7, ty + fs + 2);
  });
}
const A = () => Core.analyze(S.products, S.moves, set());

/* ---------- the AI backend: swappable ------------------------------------
   Two doors, one function:
   - 'gemini' (default): Google's Generative Language API with an API key.
   - 'custom': any local OpenAI-compatible server (llama.cpp / ollama /
     LM Studio / vLLM) running e.g. Gemma locally — base URL + model name
     in Settings. Same prompts, images ride as data URLs, JSON asked in
     prompt (local servers vary on response_format). Gemma keeps the app
     AI Builder Cup eligible (Gemini OR Gemma). */
const aiReady = () => (set().aiMode === 'custom' && set().aiBaseUrl) || !!set().apiKey;
const aiLabel = () => set().aiMode === 'custom' && set().aiBaseUrl ? `Local ${set().aiModel}` : 'Gemini AI';
// AI calls always carry a deadline, so a hung backend can never leave a busy
// spinner stuck (scan overlay, bill parse, advisor).
const fetchT = (url, opts, ms = 60000) => fetch(url, { ...opts, signal: AbortSignal.timeout(ms) })
  .catch(e => { throw new Error(e && (e.name === 'TimeoutError' || /timed?\s?out/i.test(e.message || '')) ? 'AI backend timed out — try again' : (e.message || String(e))); });
async function aiCustom(parts, json = true) {
  const base = set().aiBaseUrl.replace(/\/+$/, '').replace(/\/v1\/?$/, '');
  const content = [];
  let text = '';
  for (const p of parts) {
    if (p && p.inline_data) content.push({ type: 'image_url', image_url: { url: `data:${p.inline_data.mime_type};base64,${p.inline_data.data}` } });
    else if (p && p.audio) content.push({ type: 'input_audio', input_audio: { data: p.audio.data, format: 'wav' } });
    else text += (p && p.text || String(p ?? '')) + '\n';
  }
  content.unshift({ type: 'text', text: text.trim() + (json ? '\nAnswer ONLY with JSON. No prose, no code fences.' : '') });
  const r = await fetchT(base + '/v1/chat/completions', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ model: set().aiModel, temperature: json ? 0.2 : 0.5, messages: [{ role: 'user', content }] }),
  });
  if (!r.ok) throw new Error('local AI HTTP ' + r.status + ': ' + (await r.text()).slice(0, 150));
  const d = await r.json();
  const m0 = (d.choices || [])[0]?.message || {};
  let t = (m0.content ?? '').trim();
  if (!t && m0.reasoning_content) t = (m0.reasoning_content.match(/\{[\s\S]*\}/) || [''])[0].trim();
  if (!t) throw new Error('local AI returned no content');
  return json ? JSON.parse(t.replace(/```json|```/g, '').trim()) : t;
}
async function gemini(parts, json = true) {
  parts = parts.map(p => p && p.audio ? { inline_data: { mime_type: 'audio/wav', data: p.audio.data } } : p);
  if (set().aiMode === 'custom' && set().aiBaseUrl) return aiCustom(parts, json);
  if (!set().apiKey) throw new Error('No AI backend configured');
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(set().model)}:generateContent?key=${encodeURIComponent(set().apiKey)}`;
  const r = await fetchT(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ contents: [{ role: 'user', parts }], generationConfig: json ? { responseMimeType: 'application/json', temperature: .2 } : { temperature: .5 } }) });
  if (!r.ok) { let m = 'HTTP ' + r.status; try { m = (await r.json()).error.message; } catch (e) {} throw new Error('Gemini: ' + m); }
  const d = await r.json(); const t = (d.candidates?.[0]?.content?.parts || []).map(p => p.text || '').join('');
  return json ? JSON.parse(t.replace(/```json|```/g, '').trim()) : t.trim();
}
// Mic audio → 16 kHz mono PCM16 WAV, so the model hears it (MediaRecorder's
// webm/opus is not decodable server-side; raw PCM works in every browser).
function encodeWav(chunks, sampleRate) {
  let n = 0; for (const c of chunks) n += c.length;
  const all = new Float32Array(n); let o = 0;
  for (const c of chunks) { all.set(c, o); o += c.length; }
  const dst = 16000, ratio = dst / sampleRate, outLen = Math.max(1, Math.floor(n * ratio));
  const pcm = new Int16Array(outLen);
  for (let i = 0; i < outLen; i++) {
    const pos = i / ratio, i0 = Math.floor(pos), f = pos - i0;
    const a = all[Math.min(i0, n - 1)], b = all[Math.min(i0 + 1, n - 1)];
    const s = Math.max(-1, Math.min(1, a + (b - a) * f));
    pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
  }
  const buf = new ArrayBuffer(44 + pcm.length * 2), v = new DataView(buf);
  const ws = (off, str) => { for (let i = 0; i < str.length; i++) v.setUint8(off + i, str.charCodeAt(i)); };
  ws(0, 'RIFF'); v.setUint32(4, 36 + pcm.length * 2, true); ws(8, 'WAVE'); ws(12, 'fmt ');
  v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
  v.setUint32(24, dst, true); v.setUint32(28, dst * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true);
  ws(36, 'data'); v.setUint32(40, pcm.length * 2, true);
  for (let i = 0; i < pcm.length; i++) v.setInt16(44 + i * 2, pcm[i], true);
  return new Uint8Array(buf);
}
const b64of = u8 => { let s = ''; for (let i = 0; i < u8.length; i += 0x8000) s += String.fromCharCode.apply(null, u8.subarray(i, i + 0x8000)); return btoa(s); };
async function aiTranscribe(wavB64, lang) {
  const langName = (lang || '').startsWith('ne') ? 'Nepali' : (lang || '').startsWith('hi') ? 'Hindi' : (lang || '').startsWith('es') ? 'Spanish' : '';
  const prompt = `Transcribe this audio recording exactly as spoken, keeping the original language${langName ? ' — it is ' + langName : ''}. Output only the transcript text and nothing else.`;
  return (await gemini([{ text: prompt }, { audio: { data: wavB64 } }], false)).trim();
}

/* =========================================================== VIEWS */
function vSetup() {
  const st = U.setup;
  return `<div style="min-height:calc(100vh - 90px);display:grid;place-items:center;padding:18px">
    <div class="card" style="max-width:440px;width:100%;margin:0">
      <div class="ch"><h2><span class="ico t-ind">🛒</span>Welcome to ShelfSense AI</h2></div>
      <div class="muted" style="margin:-6px 0 14px">Step 1 — your AI backend. It powers shelf scanning, voice parsing and the advisor. Change it anytime in Settings.</div>
      <div class="chips">${[['gemini', '☁️ Google Gemini API'], ['custom', '🖥️ Local Gemma / own server']].map(([v, l]) => `<button class="chip ${st.mode === v ? 'on' : ''}" data-a="setupMode" data-v="${v}">${l}</button>`).join('')}</div>
      ${st.mode === 'gemini' ? `
        <label class="lb">Gemini API key — free at aistudio.google.com</label>
        <input class="f" id="su_key" type="password" placeholder="AIza…" autocomplete="off" value="${esc(set().apiKey)}">
        <div class="muted small mt">Cloud; works from any device. Key stays on your device.</div>` : `
        <label class="lb">Local server base URL (OpenAI-compatible)</label>
        <input class="f" id="su_url" placeholder="http://localhost:8080" value="${esc(set().aiBaseUrl)}">
        <label class="lb" style="margin-top:10px">Model name</label>
        <input class="f" id="su_model" value="${esc(set().aiModel)}">
        <div class="muted small mt">Point at your merve gateway: <code>http://localhost:8283</code> with model <code>gemma-4-e4b</code> — or any OpenAI-compatible server. Fully offline AI. Blocked by the browser? Open <code>http://localhost:8283</code> directly — that port serves this app <i>and</i> the AI on one origin.</div>`}
      <div class="g2 mt" style="border-top:1px solid var(--line);padding-top:12px">
        <div><label class="lb">Shop name</label><input class="f" id="su_name" value="${esc(set().storeName)}" placeholder="My Grocery Store"></div>
        <div><label class="lb">Currency</label><input class="f" id="su_cur" value="${esc(set().currency)}" placeholder="$"></div>
      </div>
      <div class="muted small" style="margin-top:-4px">Both are yours to change anytime in Settings.</div>
      <div class="g2 mt2"><button class="btn pri" data-a="setupTest" ${st.busy ? 'disabled' : ''}>${st.busy ? 'Testing…' : 'Test & continue'}</button>
        <button class="btn ghost" data-a="setupSkip">Skip for now</button></div>
