  const a = A(), rows = a.rows;
  if (aiReady()) {
    try {
      const facts = rows.map(r => ({ product: r.p.name, unit: r.p.unit, stock: +r.p.stock.toFixed(2), avgDaily: +r.avgDaily.toFixed(2), qty7d: +r.qty7.toFixed(2), revenue7d: +r.rev7.toFixed(2), trendPct: Math.round(r.trend * 100), daysLeft: isFinite(r.daysLeft) ? +r.daysLeft.toFixed(1) : null, status: r.status, recommendedOrder: r.reorderQty }));
      U.ai.text = await gemini([{ text: `You are the AI employee of the small grocery store "${set().storeName}". Currency ${set().currency}. Supplier lead time ${set().leadDays} days.
Per-product data computed from real sales: ${JSON.stringify(facts)}
Write a friendly briefing for the owner in ${set().lang.startsWith('es') ? 'Spanish' : 'English'} (max 140 words, plain text with emoji headers, no tables): 1) What's selling (top 3) 2) What's running out and exactly how much to reorder 3) Slow items + one action 4) One growth tip. Only use the numbers given.` }], false);
