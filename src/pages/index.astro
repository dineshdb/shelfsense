function rng(s) { return () => { s |= 0; s = s + 0x6D2B79F5 | 0; let t = Math.imul(s ^ s >>> 15, 1 | s); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }
function demo() {
  if (S.products.length && !confirm('Replace current data with the demo store?')) return;
  const R = rng(42), now = Date.now(), P = [
    ['Sugar', 'Pantry', 'kg', 9, 1.10, .80, 2.4, ['azucar', 'white sugar']], ['Rice', 'Grains', 'kg', 32, 1.40, 1.00, 2.8, ['arroz']],
    ['Whole Milk 1L', 'Dairy', 'unit', 7, 1.25, .90, 4.6, ['milk', 'leche']], ['Bread loaf', 'Bakery', 'unit', 6, 2.00, 1.30, 5.2, ['bread', 'pan']],
    ['Eggs 12-pack', 'Dairy', 'pack', 11, 3.20, 2.40, 1.6, ['eggs', 'huevos']], ['Cooking Oil 1L', 'Pantry', 'unit', 14, 3.50, 2.60, .9, ['oil', 'aceite']],
    ['Coca-Cola 600ml', 'Beverages', 'unit', 40, 1.00, .65, 6.5, ['coke', 'coca cola', 'soda', 'coca']], ['Bananas', 'Fruits', 'kg', 3, .70, .40, 3.1, ['banana', 'banano']],
    ['Tomatoes', 'Vegetables', 'kg', 7, 1.60, 1.10, 1.5, ['tomato', 'tomate']], ['Pasta 500g', 'Pantry', 'pack', 26, .90, .60, 1.2, ['pasta', 'spaghetti']],
    ['Ground Coffee 250g', 'Pantry', 'pack', 10, 4.50, 3.20, .45, ['coffee', 'cafe']], ['Black Beans', 'Grains', 'kg', 16, 1.80, 1.30, 1.1, ['beans', 'frijoles']],
    ['Bar Soap', 'Personal Care', 'unit', 34, .80, .50, .15, ['soap', 'jabon']], ['Salt 1kg', 'Pantry', 'unit', 22, .50, .30, .06, ['salt', 'sal']]];
  S.products = []; S.moves = [];
  P.forEach(([name, category, unit, stock, price, cost, rate, aliases], k) => {
    const id = 'p' + k; S.products.push({ id, name, category, unit, stock, price, cost, aliases, minStock: null, createdAt: now - 22 * DAY });
    for (let d = 21; d >= 0; d--) {
      const day = new Date(now - d * DAY), wk = [0, 6].includes(day.getDay()) ? 1.35 : 1, ramp = name.startsWith('Coca') ? .7 + (21 - d) / 35 : 1;
      let q = rate * wk * ramp * (.5 + R()); if (d === 0) q *= Math.min(1, (new Date().getHours() + 1) / 20);
      const tx = Math.max(0, Math.round(q / (unit === 'kg' ? 1.5 : 2)));
      for (let t = 0; t < tx; t++) {
        const qq = unit === 'kg' ? Math.max(.25, Math.round(q / tx * 4) / 4) : Math.max(1, Math.round(q / tx));
        const ts = new Date(day); ts.setHours(7 + Math.floor(R() * 12), Math.floor(R() * 60), 0, 0); if (ts.getTime() > now) continue;
        S.moves.push({ id: uid(), productId: id, type: 'sale', qty: qq, delta: -qq, unitPrice: price, total: +(qq * price).toFixed(2), ts: ts.getTime(), source: 'demo' });
      }
    }
  });
  if (S.settings.storeName === DEF.storeName) S.settings.storeName = 'Abarrotes La Esquina';
  U.ai.text = ''; save(); go('home'); toast('✨ Demo store loaded — 14 products, 3 weeks of sales', 'ok');
}
function quick(id, type) {
  const p = prod(id), step = p.unit === 'g' || p.unit === 'ml' ? 100 : 1;
  if (type === 'sale') { if (p.stock <= 0) return toast(p.name + ' is out of stock', 'warn'); const q = Math.min(step, p.stock); p.stock = +(p.stock - q).toFixed(3);
    S.moves.push({ id: uid(), productId: id, type: 'sale', qty: q, delta: -q, unitPrice: p.price, total: +(q * p.price).toFixed(2), ts: Date.now(), source: 'manual' }); }
  else { p.stock = +(p.stock + step).toFixed(3); S.moves.push({ id: uid(), productId: id, type: 'restock', qty: step, delta: step, ts: Date.now(), source: 'manual' }); }
  save(); $('#stocklist').innerHTML = stockList();
}
function saveP() {
  const e = U.edit, g = id => $('#' + id).value, name = g('e_name').trim(); if (!name) return toast('Name is required', 'warn');
  const d = { name, aliases: g('e_alias').split(',').map(s => s.trim()).filter(Boolean), category: g('e_cat'), unit: g('e_unit'), stock: +g('e_stock') || 0, minStock: g('e_min') === '' ? null : +g('e_min'), price: +g('e_price') || 0, cost: +g('e_cost') || 0 };
  if (e.id) { const p = prod(e.id), b = p.stock; Object.assign(p, d); if (b !== p.stock) S.moves.push({ id: uid(), productId: p.id, type: 'adjust', qty: +(p.stock - b).toFixed(3), delta: +(p.stock - b).toFixed(3), ts: Date.now(), source: 'edit' }); }
