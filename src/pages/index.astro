      const r = await gemini([{ text: 'Reply with JSON {"ok":true}' }]);
      if (!r || !r.ok) throw new Error('unexpected reply from the backend');
      set().setupDone = true;
      st.busy = false;
      save();
      render();
      toast(`✅ ${aiLabel()} connected — welcome aboard`, 'ok');
    } catch (e) {
      st.busy = false;
      const m = e.message || String(e);
      st.msg = /HTTP 405/.test(m) ? 'That port is a raw gateway without CORS (405). Use the shim: http://localhost:8283'
        : /HTTP 404/.test(m) ? 'No OpenAI-compatible endpoint there — check the URL'
        : /fetch/i.test(m) || /net::|NetworkError|Load failed/i.test(m) ? 'The browser blocked the call to your local server. Easiest fix: open http://localhost:8283 — it serves this app AND the AI on one origin.'
        : m;
      render();
    }
  },
  cat: el => { U.inv.cat = el.dataset.v; render(); },
  sort: el => { U.inv.sort = el.dataset.v; render(); },
  qm: el => quick(el.dataset.v, el.dataset.t),
  invCsv: () => {
    const rows = Core.analyze(S.products, S.moves, set()).rows.sort((a, b) => a.p.name.localeCompare(b.p.name));
    const cell = x => { const v = String(x ?? '').replace(/"/g, '""'); return '"' + (/^[=+\-@\t\r]/.test(v) ? ' ' + v : v) + '"'; };
    const csv = ['Name,Category,Unit,Stock,MinStock,Price,Cost,Value,Status']
      .concat(rows.map(r => [
        r.p.name,
        r.p.category || 'Other',
        r.p.unit,
        r.p.stock,
        r.p.minStock ?? '',
        r.p.price,
        r.p.cost ?? '',
        (Math.max(0, r.p.stock) * (r.p.cost || r.p.price * 0.75 || 0)).toFixed(2),
        r.status
      ].map(cell).join(','))).join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
    a.download = `inventory-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    toast('📊 Inventory CSV downloaded', 'ok');
  },
  adjustStock: () => {
    const e = U.edit;
    const p = e && prod(e.id);
    if (!p) return toast('Save the product first', 'warn');
    const mode = $('#a_mode').value, q = +$('#a_qty').value, note = $('#a_note').value.trim();
    if (!(q > 0)) return toast('Enter a quantity', 'warn');
    if (mode === 'remove' && q > p.stock) return toast(`Only ${fq(p.stock, p.unit)} in stock`, 'warn');
    const b = p.stock;
    const ns = Math.max(0, +(mode === 'set' ? q : mode === 'add' ? b + q : b - q).toFixed(3));
    const delta = +(ns - b).toFixed(3);
    p.stock = ns; e.stock = ns;
    S.moves.push({ id: uid(), productId: p.id, type: 'adjust', qty: Math.abs(delta), delta, ts: Date.now(), source: 'adjust', text: note || `${mode} ${q}` });
    save();
    $('#e_stock').value = ns; $('#a_qty').value = ''; $('#a_note').value = '';
    $('#sheet').innerHTML = vSheet(S, U);
    $('#stocklist').innerHTML = stockList(S, U);
    toast(`✅ ${p.name}: ${delta >= 0 ? '+' : '−'}${fq(Math.abs(delta), p.unit)} — now ${fq(ns, p.unit)}`, 'ok');
  },
  edit: el => {
    const p = prod(el.dataset.v);
    U.edit = p ? { ...p } : { id: null, name: '', barcode: '', aliases: [], category: 'Pantry', unit: 'unit', stock: 0, minStock: null, price: 0, cost: 0 };
    render();
  },
  closeSheet: (el, ev) => {
    if (ev.target.closest('[data-stop]') && el.classList.contains('sheetbg')) return;
    U.edit = null;
    render();
  },
  saveP,
  delP: () => {
    if (!confirm('Delete this product and its history?')) return;
    const id = U.edit.id;
    S.products = S.products.filter(p => p.id !== id);
    S.moves = S.moves.filter(m => m.productId !== id);
    U.edit = null;
    save();
    render();
  },
  toggle: el => {
    S.settings[el.dataset.v] = !S.settings[el.dataset.v];
    save();
    el.classList.toggle('on');
  },
  showkey: el => {
    const k = $('#key');
    k.type = k.type === 'password' ? 'text' : 'password';
    el.textContent = k.type === 'password' ? 'Show' : 'Hide';
  },
  test: async () => {
    try {
      const r = await gemini([{ text: 'Reply with JSON {"ok":true}' }]);
      toast(r && r.ok ? `✅ ${aiLabel()} connected` : 'Unexpected reply', r && r.ok ? 'ok' : 'warn');
    } catch (e) {
      toast(e.message, 'err', 5000);
    }
  },
  export: () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify({ ...S, settings: { ...S.settings, apiKey: '' } }, null, 2)], { type: 'application/json' }));
    a.download = `shelfsense-${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
  },
  reset: () => {
    if (confirm('Erase all products and sales on this device?')) {
      S.products = []; S.moves = []; S.khata = {}; U.ai.text = '';
      save(); render(); toast('All data erased');
    }
  }
};

document.addEventListener('click', ev => {
  const el = ev.target.closest('[data-a]');
  if (!el) return;
  if (el.dataset.a === 'closeSheet' && el.classList.contains('sheetbg') && ev.target.closest('[data-stop]')) return;
  const f = ACT[el.dataset.a];
  if (f) { ev.preventDefault(); f(el, ev); }
});

document.addEventListener('input', ev => {
  const t = ev.target;
  if (t.id === 'q') { U.inv.q = t.value; $('#stocklist').innerHTML = stockList(S, U); }
  if (t.id === 'billCustomer') { U.voice.customer = t.value; }
  if (t.dataset.det !== undefined) {
    const d = U.scan.dets[+t.dataset.det], k = t.dataset.k;
    d[k] = t.type === 'checkbox' ? t.checked : (t.type === 'number' ? (t.value === '' ? null : +t.value) : t.value);
  }
  if (t.dataset.bi !== undefined) {
    const b = U.voice.bill[+t.dataset.bi];
    if (t.dataset.bk === 'qty') b.qty = +t.value;
    else if (t.dataset.bk === 'include') { b.include = t.checked; render(); }
    else b[t.dataset.bk] = t.value;
  }
});

document.addEventListener('change', ev => {
  const t = ev.target;
  if (t.dataset.set) {
    const k = t.dataset.set;
    S.settings[k] = t.type === 'number' ? (+t.value || 0) : t.value.trim();
    save();
    if (k === 'model') render();
    $('#storeName').textContent = set().storeName;
    const pill = $('#enginePill');
    pill.className = 'pill ' + (aiReady() ? '' : 'off');
    pill.innerHTML = `<i></i>${aiReady() ? aiLabel() : 'AI off'}`;
  }
  if (t.dataset.det !== undefined) {
    const d = U.scan.dets[+t.dataset.det];
    if (t.dataset.k === 'name') {
      const m = Core.matchProduct(d.name, S.products);
      d.matchId = m.product?.id || null;
      if (m.product && !d.price && U.scan.mode !== 'rcpt') d.price = m.product.price;
      render();
    } else if (t.dataset.k === 'include') render();
  }
  if (t.id === 'photoIn') {
    const fs = [...t.files].slice(0, 6);
    t.value = '';
    if (fs.length) {
      if (U.scan.mode === 'barcode') {
        fileToURL(fs[0]).then(d => resize(d)).then(url => {
          if (hasBarcodeDetector) {
            const im = new Image();
            im.onload = async () => {
              try {
                const det = new window.BarcodeDetector();
                const codes = await det.detect(im);
                if (codes?.length && codes[0].rawValue) {
                  onBarcodeScanned(codes[0].rawValue);
                  return;
                }
              } catch (e) {}
              toast('No barcode recognized in photo — try another', 'warn');
            };
            im.src = url;
          } else {
            toast('Live camera or typing barcode recommended on this browser', 'warn');
          }
        }).catch(e => toast(e.message, 'err'));
        return;
      }
      Promise.all(fs.map(f => fileToURL(f).then(d => resize(d)))).then(analyze).catch(e => toast(e.message, 'err'));
    }
  }
  if (t.id === 'importIn') {
    const f = t.files[0];
    t.value = '';
    if (!f) return;
    f.text().then(x => {
      const d = JSON.parse(x);
      if (!Array.isArray(d.products) || !Array.isArray(d.moves)) throw new Error('not a ShelfSense export');
      S.products = d.products;
      S.moves = d.moves;
      if (d.khata) S.khata = d.khata;
      if (d.settings) Object.assign(S.settings, { ...d.settings, apiKey: S.settings.apiKey });
      save();
      render();
      toast('Imported', 'ok');
    }).catch(() => toast('Invalid file — expected a ShelfSense export', 'err'));
  }
});

document.addEventListener('keydown', ev => {
  if (ev.key === 'Enter') {
    if (ev.target.id === 'typed') ACT.typed();
    if (ev.target.id === 'manualBarcode') ACT.manualBarcode();
  }
  if (ev.key === 'Escape' && U.edit) { U.edit = null; render(); }
});

// Initialize Cloud Sync
initCloudSync({ S, set, DEF, save, render, toast });

/* ---------- Boot ---------- */
$('#logo').innerHTML = ICONS.logo;
document.querySelectorAll('.nav button').forEach(b => {
  const ic = { home: ICONS.home, scan: ICONS.scan, sell: ICONS.mic, stock: ICONS.box, settings: ICONS.gear }[b.dataset.v];
  b.insertAdjacentHTML('afterbegin', b.dataset.v === 'sell' ? `<span class="fabm">${ic}</span>` : ic);
});

render();

setInterval(() => {
  if (U.tab === 'home' && !U.edit && !U.ai.busy && document.visibilityState === 'visible' && !document.activeElement?.matches('input,select')) {
    render();
  }
}, 60000);

})();
    </script>
  </body>
</html>
