}
const go = t => { if (t !== 'scan') stopCam(); if (t !== 'sell' && U.voice.recording) stopRec(); U.tab = t; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); };

/* =========================================================== SCAN */
async function startCam() {
  if (!navigator.mediaDevices?.getUserMedia) { toast('Live camera needs HTTPS — opening photo capture instead', 'warn'); $('#photoIn').click(); return; }
  try {
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false });
    U.scan.image = null; U.scan.dets = []; U.scan.camOn = true; render();
  } catch (e) { toast('Camera unavailable (' + e.message + ') — opening photos', 'warn', 4500); $('#photoIn').click(); }
}
function stopCam() { if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; } U.scan.camOn = false; }
function capture() {
  const v = $('#video'); if (!v || !v.videoWidth) return toast('Camera not ready yet', 'warn');
  const k = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight)), c = document.createElement('canvas'); c.width = v.videoWidth * k; c.height = v.videoHeight * k;
  c.getContext('2d').drawImage(v, 0, 0, c.width, c.height); const url = c.toDataURL('image/jpeg', .85); stopCam(); analyze([url]);
}
async function geminiDetect(imgs) {
  const prompt = `You are the inventory vision system of a small grocery store. ${imgs.length > 1 ? `These ${imgs.length} images are frames from one video sweep of the same shelves; merge them and do NOT double-count items seen in several frames.` : 'Analyze the shelf image.'}
Identify every distinct retail product. Read brand and size from packaging when legible (e.g. "Coca-Cola 600ml"), else use a clear generic name ("Bananas", "White Sugar 1kg").
Return ONLY a JSON array, one object per distinct product: {"name": string, "category": one of ${JSON.stringify(Object.keys(CAT))}, "count": integer visible units (estimate kg for loose produce), "unit": "unit"|"kg"|"L"|"pack", "confidence": 0-1, "price_guess": typical local retail price number or null, "box_2d": [ymin,xmin,ymax,xmax] normalized 0-1000 around all units of that product in the FIRST image, or null}.`;
  const r = await gemini([{ text: prompt }, ...imgs.map(d => ({ inline_data: { mime_type: 'image/jpeg', data: d.split(',')[1] } }))]);
  return (Array.isArray(r) ? r : (r.products || r.items || [])).filter(x => x && x.name).map(x => ({ name: x.name, category: x.category, count: Math.round(+x.count || 1), unit: x.unit, confidence: x.confidence, price: x.price_guess, box: x.box_2d || null }));
}
async function receiptParse(imgs) {
  const prompt = `You read purchase receipts for a small grocery store. ${imgs.length > 1 ? `These ${imgs.length} images are photos of ONE receipt (maybe several pages) — merge them and do not double-count lines.` : 'Read the receipt.'}
Extract every PRODUCT line the store bought. Skip totals, subtotals, taxes, deposits, discounts, addresses and phone numbers.
Give short English product names: keep brand and size when printed (e.g. "Coca-Cola 600ml"), else generic ("White Sugar 1kg"). A quantity of 1 with no printed number is normal for receipts.
Return ONLY JSON: {"store": string|null, "date": "YYYY-MM-DD"|null, "total": number|null, "items": [{"name": string, "qty": number, "unit": "unit"|"kg"|"g"|"L"|"ml"|"pack", "cost": number|null (unit cost paid), "confidence": 0-1}]}. If the image is not a receipt or is unreadable, return {"store":null,"date":null,"total":null,"items":[]}.`;
  const r = await gemini([{ text: prompt }, ...imgs.map(d => ({ inline_data: { mime_type: 'image/jpeg', data: d.split(',')[1] } }))]);
  return { store: r.store || null, date: r.date || null, total: r.total != null ? +r.total : null,
    items: (Array.isArray(r) ? r : (r.items || [])).filter(x => x && x.name).map(x => ({ name: x.name, count: +x.qty || 1, unit: x.unit, price: x.cost != null ? +x.cost : null, confidence: x.confidence })) };
}
async function analyze(imgs) {
  const sc = U.scan; sc.image = imgs[0]; sc.dets = []; sc.rcpt = null; sc.busy = true;
  if (sc.mode === 'rcpt') { // receipt intake: vision-only, needs an AI backend
    if (!aiReady()) { sc.busy = false; render(); return toast('Reading receipts needs an AI backend — Settings → AI backend', 'warn', 5000); }
    sc.status = 'Reading the receipt with ' + aiLabel() + '…'; render();
    let r = null;
    try { r = await receiptParse(imgs); sc.engine = aiLabel() + ' · receipt'; }
    catch (e) { toast('Receipt read failed: ' + e.message + ' — try a flatter, well-lit shot', 'err', 6000); }
    sc.busy = false; sc.rcpt = r;
    sc.dets = (r ? r.items : []).map(x => { const m = Core.matchProduct(x.name, S.products);
      return { name: x.name, category: m.product?.category || 'Other', count: Math.max(0, +x.count || 1), unit: UNITS.includes(x.unit) ? x.unit : 'unit', cost: +x.price || null, confidence: x.confidence, box: null, include: true, matchId: m.product?.id || null }; });
    render();
    if (sc.dets.length) toast(`Read ${sc.dets.length} line${sc.dets.length > 1 ? 's' : ''} — check them, then log the delivery`, 'ok'); else toast('No receipt lines recognized — try a closer, well-lit photo', 'warn', 5000);
    return;
  }
  if (!aiReady()) { sc.busy = false; render(); return toast('Scanning needs an AI backend — Settings → AI backend', 'warn', 5000); }
  sc.status = aiLabel() + ` is identifying products in ${imgs.length} image${imgs.length > 1 ? 's' : ''}…`; render();
  let d = [];
  try { d = await geminiDetect(imgs); sc.engine = aiLabel(); }
  catch (e) { toast(e.message, 'err', 5000); }
  sc.busy = false;
  sc.dets = d.map(x => { const m = Core.matchProduct(x.name, S.products); return { name: x.name, category: CAT[x.category] ? x.category : 'Other', count: Math.max(0, +x.count || 1), unit: UNITS.includes(x.unit) ? x.unit : 'unit', price: m.product ? m.product.price : (+x.price || null), confidence: x.confidence, box: x.box, include: true, matchId: m.product?.id || null }; });
  render();
  if (d.length) toast(`Found ${d.length} product type${d.length > 1 ? 's' : ''}`, 'ok'); else toast('No products recognized — try a closer, well-lit photo', 'warn', 5000);
}
function commit(mode) {
  const rcpt = U.scan.mode === 'rcpt';
  if (rcpt) mode = 'add'; // a receipt is what arrived — never an absolute shelf count
  const src = rcpt ? 'receipt' : 'scan';
  let a = 0, u = 0;
  U.scan.dets.filter(d => d.include && d.name.trim()).forEach(d => {
    const q = +d.count || 0; let p = d.matchId && prod(d.matchId);
    if (p) { const b = p.stock; p.stock = mode === 'set' ? q : +(p.stock + q).toFixed(3);
      if (rcpt && d.cost) { p.cost = +d.cost; if (!p.price) p.price = +(d.cost * 1.35).toFixed(2); }
      if (!rcpt && d.price) p.price = +d.price;
      S.moves.push({ id: uid(), productId: p.id, type: mode === 'set' ? 'adjust' : 'restock', qty: +(p.stock - b).toFixed(3), delta: +(p.stock - b).toFixed(3), ts: Date.now(), source: src }); u++; }
    else { p = { id: uid(), name: d.name.trim(), aliases: [], category: d.category, unit: d.unit, stock: q,
        price: rcpt ? (d.cost ? +(d.cost * 1.35).toFixed(2) : 0) : +d.price || 0,
        cost: rcpt ? +d.cost || 0 : (d.price ? +(d.price * .75).toFixed(2) : 0),
        minStock: null, createdAt: Date.now() };
      S.products.push(p); S.moves.push({ id: uid(), productId: p.id, type: 'restock', qty: q, delta: q, ts: Date.now(), source: src }); a++; }
  });
  save(); U.scan.image = null; U.scan.dets = []; U.scan.rcpt = null;
  toast(`${rcpt ? '📦 Delivery logged' : '✅ Inventory updated'}: ${a} new, ${u} updated`, 'ok'); go('stock');
}

/* =========================================================== VOICE */
async function listen() {
  if (U.voice.recording) return stopRec();
  if (!aiReady()) return toast('Voice needs an AI backend — Settings → AI backend', 'warn', 5000);
  if (!navigator.mediaDevices?.getUserMedia) return toast('Microphone needs HTTPS — type the command instead', 'warn', 5000);
  startRec();
}
async function startRec() {
  if (!S.products.length) toast('Tip: add products first (Scan or Load demo)', 'warn');
  let stream;
  try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
  catch (e) { return toast('Mic unavailable: ' + e.message, 'err', 5000); }
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const src = ctx.createMediaStreamSource(stream);
  const proc = ctx.createScriptProcessor(4096, 1, 1);
  const chunks = [];
  proc.onaudioprocess = e => { if (U.voice.recording) chunks.push(new Float32Array(e.inputBuffer.getChannelData(0))); };
  src.connect(proc); proc.connect(ctx.destination);
  U.voice.rec = { stream, ctx, src, proc, chunks };
  U.voice.recording = true; U.voice.transcript = ''; render();
  U.voice.recCap = setTimeout(() => { if (U.voice.recording) stopRec(); }, 30000);
}
async function stopRec() {
  const r = U.voice.rec; if (!r) return;
  clearTimeout(U.voice.recCap);
  U.voice.recording = false; U.voice.busy = true; render();
  try { r.proc.disconnect(); r.src.disconnect(); } catch (e) {}
  r.stream.getTracks().forEach(t => t.stop());
  const wav = encodeWav(r.chunks, r.ctx.sampleRate);
  try { r.ctx.close(); } catch (e) {}
  U.voice.rec = null;
  if (wav.length < 6000) { U.voice.busy = false; render(); return toast('No speech caught — tap the mic and speak', 'warn'); }
  try {
    const text = await aiTranscribe(b64of(wav), set().lang);
    U.voice.busy = false;
    if (!text) { render(); return toast('Nothing heard — try again a little closer to the mic', 'warn', 5000); }
    const el = $('#trans'); if (el) { el.textContent = '“' + text + '”'; el.classList.remove('ph2'); }
    command(text, 'voice');
  } catch (e) {
    U.voice.busy = false; render();
    toast('Transcription failed: ' + e.message + ' — you can type the command', 'err', 6000);
  }
}
async function command(text, source) {
  U.voice.transcript = text;
  if (!aiReady()) return toast('Parsing needs an AI backend — Settings → AI backend', 'warn', 5000);
  if (!S.products.length) { render(); return toast('Add products first — Scan the store or Load demo', 'warn'); }
  U.voice.busy = true; render();
  let P;
  try {
    const r = await gemini([{ text: `You parse voice commands from a grocery shop owner. The command may be in English, Spanish, Hindi (हिन्दी) or Nepali (नेपाली) — including Devanagari script, Devanagari digits (०१२३४५६७८९), and romanized words (chini, bhaat, chamal, chiya, nun, tel, dal). Half = 0.5, quarter = 0.25, "एक पाउ" ≈ 0.5 kg, "आधा किलो" = 0.5 kg, "पाउ" ≈ 0.55 kg if unsure use 0.5. Inventory product names: ${JSON.stringify(S.products.map(p => p.name))}.
Command: "${text}"
Return JSON {"items":[{"intent":"sale"|"restock","product": the inventory name copied VERBATIM — never translate, translate-from or shorten it; null only if nothing in the inventory fits (match by meaning across languages: चिनी/cheeni→Sugar, चामल/भात/chamal/bhaat→Rice, चिया→Tea, नुन→Salt, तेल→oil, दाल→lentils),"heard": the owner's words for that item, in the original language,"qty": number,"unit":"kg"|"g"|"L"|"ml"|"unit"|"pack"|"dozen"|null}]} — one entry PER item mentioned, each with ITS OWN intent, because one command can mix them ("rice sold and eggs arrived"). sold/bikri/bikri bhayo/becha/vendí/बिक्री/बेचा = sale; received/arrived/delivery/llegaron/आयो/आए/पसलमा आयो/मंगाएको/खरिद = restock.` }]);
    P = Core.normalizeModelParse(r, text, S.products);
  } catch (e) { U.voice.busy = false; render(); return toast('AI parsing unavailable: ' + e.message, 'warn', 5000); }
  U.voice.busy = false;
  if (!P.items.length) { render(); toast('I didn\'t catch a product. Try: “two bread sold”', 'warn'); speak('Sorry, I did not catch the product.'); return; }
  P.items.forEach(it => U.voice.bill.push({ id: uid(), text, intent: it.intent || P.intent, query: it.query, qty: it.qty, unit: it.unit, productId: it.productId, include: true, source }));
  render();
