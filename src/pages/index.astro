    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛒</text></svg>">
    <script is:inline>
      // Theme before first paint: the manual Light/Dark/System choice from
      // localStorage, falling back to the OS (the Board pattern). The chrome
      // colors track the design-system canvas.
      (() => {
        const paintChrome = (dark) => {
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? "#010507" : "#ffffff");
        };
        let stored = null;
        try { stored = localStorage.getItem("shelfsense:theme"); } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = stored === "dark" || stored === "light" ? stored === "dark" : prefersDark;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        paintChrome(dark);
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          let s = null;
          try { s = localStorage.getItem("shelfsense:theme"); } catch {}
          if (s === "dark" || s === "light") return;
          document.documentElement.dataset.theme = e.matches ? "dark" : "light";
          paintChrome(e.matches);
        });
      })();
    </script>
    <script is:inline>
      /* Firebase web app config — paste from the Firebase console
         (Project settings → Your apps → Web app). Empty = local-only. */
      window.FIREBASE_CONFIG = {"projectId": "shelfsense-df2265", "appId": "1:186697947131:web:d247d9fa47daebebbc1d5e", "storageBucket": "shelfsense-df2265.firebasestorage.app", "apiKey": "AIzaSyB1Rez7wGjjZ0XgaCfQ1OB2wbZ2PfjNs_o", "authDomain": "shelfsense-df2265.firebaseapp.com", "messagingSenderId": "186697947131", "projectNumber": "186697947131", "version": "2"};
    </script>
  </head>
