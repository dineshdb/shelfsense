  }
  const best = rows.filter(r => r.rev7 > 0).sort((x, y) => y.rev7 - x.rev7).slice(0, 3), low = rows.filter(r => r.status === 'low' || r.status === 'out').sort((x, y) => x.daysLeft - y.daysLeft).slice(0, 4), slow = rows.filter(r => r.status === 'slow').slice(0, 3);
