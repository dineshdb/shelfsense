---
// ShelfSense AI — one client-rendered page (owner ruling: no server
// rendering). Vite + Tailwind for the toolchain; Firebase from npm.
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <title>ShelfSense AI · Smart Retail Assistant</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛒</text></svg>">
    <script is:inline>
      // Theme before first paint: the manual Light/Dark/System choice from
      // localStorage, falling back to the OS (the Board pattern). The chrome
      // colors track the design-system canvas.
      (() => {
        const paintChrome = (dark) => {
          document.querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", dark ? "#010507" : "#ffffff");
        };
        let stored = null;
        try { stored = localStorage.getItem("shelfsense:theme"); } catch {}
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const dark = stored === "dark" || stored === "light" ? stored === "dark" : prefersDark;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        paintChrome(dark);
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          let s = null;
          try { s = localStorage.getItem("shelfsense:theme"); } catch {}
          if (s === "dark" || s === "light") return;
          document.documentElement.dataset.theme = e.matches ? "dark" : "light";
          paintChrome(e.matches);
        });
      })();
    </script>
    <script is:inline>
      /* Firebase web app config — paste from the Firebase console
         (Project settings → Your apps → Web app). Empty = local-only. */
      window.FIREBASE_CONFIG = {"projectId": "shelfsense-df2265", "appId": "1:186697947131:web:d247d9fa47daebebbc1d5e", "storageBucket": "shelfsense-df2265.firebasestorage.app", "apiKey": "AIzaSyB1Rez7wGjjZ0XgaCfQ1OB2wbZ2PfjNs_o", "authDomain": "shelfsense-df2265.firebaseapp.com", "messagingSenderId": "186697947131", "projectNumber": "186697947131", "version": "2"};
    </script>
  </head>
  <body>

<div class="shell">
  <div class="appbar">
    <div class="brand" data-a="tab" data-v="home" title="Home">
      <div class="logo" id="logo"></div>
      <div class="bt"><b id="storeName">My Grocery Store</b>
        <span class="bp"><span class="pill off" id="enginePill"><i></i>AI off</span><span class="pill off" id="cloudPill" style="display:none"><i></i></span></span></div>
    </div>
    <nav class="nav">
      <button data-a="tab" data-v="scan"><span>Scan</span></button>
      <button data-a="tab" data-v="sell"><span>Sell</span></button>
      <button data-a="tab" data-v="stock"><span>Stock</span></button>
      <button data-a="tab" data-v="settings"><span>Settings</span></button>
    </nav>
  </div>
  <main id="view"></main>
</div>
<div id="sheet"></div>
<div class="toasts" id="toasts"></div>
<input type="file" id="photoIn" accept="image/*" capture="environment" multiple hidden>
<input type="file" id="importIn" accept="application/json" hidden>

    <script>
      // Firebase from npm (Vite bundles it) — exposed through the same
      // window.__firebase door the app's sync engine reads.
      import { initializeApp, getApps } from "firebase/app";
      import { getAuth, signInAnonymously, onAuthStateChanged } from "firebase/auth";
      import { getFirestore, doc, getDoc, onSnapshot, runTransaction } from "firebase/firestore";
      window.__firebase = { initializeApp, getAuth, signInAnonymously, onAuthStateChanged, getFirestore, doc, getDoc, onSnapshot, runTransaction };

      // Core modules & view components
      import { Core } from "../core.js";
      import { DAY, DEF, CAT, UNITS, ICONS } from "../modules/constants.js";
      import { $, esc, uid, money, fq, daysTxt, ago, emoji, beep, toast, speak, fileToURL, resize, drawBoxes } from "../modules/utils.js";
      import { encodeWav, b64of } from "../modules/audio.js";
      import { S, U, set, prod, findByBarcode, save } from "../modules/state.js";
      import { aiReady, aiLabel, gemini, aiTranscribe, geminiDetect, receiptParse, fetchActiveModels } from "../modules/ai.js";
      import { recordKhataDebit, recordKhataPayment } from "../modules/khata.js";
      import { initCloudSync } from "../modules/cloud.js";

      import { vSetup } from "../views/setup.js";
      import { vHome } from "../views/home.js";
      import { vScan } from "../views/scan.js";
      import { vSell } from "../views/sell.js";
      import { vStock, stockList } from "../views/stock.js";
      import { vSettings } from "../views/settings.js";
      import { vSheet } from "../views/sheet.js";

/* ===== ShelfSense AI Orchestration ===== */
(() => {
const hasBarcodeDetector = typeof window !== 'undefined' && 'BarcodeDetector' in window;
const hasSpeechRec = typeof window !== 'undefined' && ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window);
let stream = null;

/* ---------- Render Coordinator ---------- */
function render() {
  const barEl = document.querySelector('.appbar');
  if (!set().setupDone) {
    if (barEl) barEl.style.display = 'none';
    $('#view').innerHTML = vSetup(U, S);
    $('#sheet').innerHTML = '';
    return;
  }
  if (barEl) barEl.style.display = '';
  $('#storeName').textContent = set().storeName;
  const pill = $('#enginePill');
  if (pill) {
    pill.className = 'pill ' + (aiReady() ? '' : 'off');
    pill.innerHTML = `<i></i>${aiReady() ? aiLabel() : 'AI off'}`;
  }

  const V = {
    home: () => vHome(S, U),
    scan: () => vScan(S, U),
    sell: () => vSell(S, U),
    stock: () => vStock(S, U),
    settings: () => vSettings(S, U)
  }[U.tab] || (() => vHome(S, U));

  $('#view').innerHTML = `<div class="view">${V()}</div>`;
  $('#sheet').innerHTML = vSheet(S, U);
  document.querySelectorAll('.nav button').forEach(b => b.classList.toggle('on', b.dataset.v === U.tab));

  if (U.tab === 'scan') {
    const v = $('#video');
    if (v && stream) { v.srcObject = stream; v.play().catch(() => {}); }
    const img = $('#shot');
    if (img) {
      const draw = () => drawBoxes($('#shotCv'), img.naturalWidth, img.naturalHeight, U.scan.dets);
      img.complete ? draw() : (img.onload = draw);
    }
  }
}

const go = t => {
  if (t !== 'scan') stopCam();
  if (t !== 'sell' && U.voice.recording) stopRec();
  U.tab = t;
  render();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

/* ---------- Barcode Hardware Loop ---------- */
let barcodeTimer = null;
function startBarcodeLoop() {
  stopBarcodeLoop();
  if (!hasBarcodeDetector) return;
  let detector;
  try {
    detector = new window.BarcodeDetector({ formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'qr_code', 'itf'] });
  } catch (e) {
    try { detector = new window.BarcodeDetector(); } catch (e2) { return; }
  }
  const check = async () => {
    if (!U.scan.camOn || U.scan.mode !== 'barcode' || U.scan.barcode) return;
    const v = $('#video');
    if (v && v.readyState >= 2) {
      try {
        const codes = await detector.detect(v);
        if (codes && codes.length > 0 && codes[0].rawValue) {
          onBarcodeScanned(codes[0].rawValue);
          return;
        }
      } catch (e) {}
    }
    if (U.scan.camOn && U.scan.mode === 'barcode' && !U.scan.barcode) {
      barcodeTimer = setTimeout(check, 250);
    }
  };
  barcodeTimer = setTimeout(check, 350);
}
function stopBarcodeLoop() {
  if (barcodeTimer) { clearTimeout(barcodeTimer); barcodeTimer = null; }
}
function onBarcodeScanned(code) {
  stopBarcodeLoop();
  stopCam();
  beep();
  U.scan.barcode = { code: String(code).trim() };
  render();
  const bp = findByBarcode(code);
  if (bp) toast(`🏷️ Matched: ${bp.name}`, 'ok');
  else toast(`🏷️ Read barcode: ${code} (Not in inventory)`, 'warn');
}

/* ---------- Camera & Vision Operations ---------- */
async function startCam() {
  if (!navigator.mediaDevices?.getUserMedia) {
    toast('Live camera needs HTTPS — opening photo capture instead', 'warn');
    $('#photoIn').click();
    return;
  }
  try {
    stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } }, audio: false });
    U.scan.image = null; U.scan.dets = []; U.scan.camOn = true; render();
    if (U.scan.mode === 'barcode') startBarcodeLoop();
  } catch (e) {
    toast('Camera unavailable (' + e.message + ') — opening photos', 'warn', 4500);
    $('#photoIn').click();
  }
}
function stopCam() {
  stopBarcodeLoop();
  if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
  U.scan.camOn = false;
}
function capture() {
  const v = $('#video');
  if (!v || !v.videoWidth) return toast('Camera not ready yet', 'warn');
  const k = Math.min(1, 1280 / Math.max(v.videoWidth, v.videoHeight));
  const c = document.createElement('canvas');
  c.width = v.videoWidth * k; c.height = v.videoHeight * k;
  c.getContext('2d').drawImage(v, 0, 0, c.width, c.height);
  const url = c.toDataURL('image/jpeg', 0.85);
  stopCam();
  analyze([url]);
}

async function analyze(imgs) {
  const sc = U.scan;
  sc.image = imgs[0];
  sc.dets = [];
  sc.rcpt = null;
  sc.busy = true;

  if (sc.mode === 'rcpt') {
    if (!aiReady()) {
      sc.busy = false;
      render();
      return toast('Reading invoices needs an AI backend — Settings → AI backend', 'warn', 5000);
    }
    sc.status = 'Reading the wholesale invoice with ' + aiLabel() + '…';
    render();
    let r = null;
    try {
      r = await receiptParse(imgs);
      sc.engine = aiLabel() + ' · wholesale invoice';
    } catch (e) {
      toast('Invoice read failed: ' + e.message + ' — try a flatter, well-lit shot', 'err', 6000);
    }
    sc.busy = false;
    sc.rcpt = r;
    sc.dets = (r ? r.items : []).map(x => {
      const m = Core.matchProduct(x.name, S.products);
      const p = m.product;
      const unitCost = +x.cost || null;
      const oldCost = p?.cost || null;
      const costDiff = (oldCost && unitCost) ? +(unitCost - oldCost).toFixed(2) : null;
      const sellPrice = x.mrp || p?.price || (unitCost ? +(unitCost * 1.35).toFixed(2) : null);
      return {
        name: x.name,
        category: p?.category || 'Other',
        count: Math.max(0, +x.count || 1),
        unit: UNITS.includes(x.unit) ? x.unit : 'unit',
        cost: unitCost,
        oldCost,
        costDiff,
        price: sellPrice,
        confidence: x.confidence,
        box: null,
        include: true,
        matchId: p?.id || null
      };
    });
    render();
    if (sc.dets.length) toast(`Parsed ${sc.dets.length} invoice line${sc.dets.length > 1 ? 's' : ''} — check costs & margins`, 'ok');
    else toast('No invoice lines recognized — try a closer, well-lit photo', 'warn', 5000);
    return;
  }

  if (!aiReady()) {
    sc.busy = false;
    render();
    return toast('Scanning needs an AI backend — Settings → AI backend', 'warn', 5000);
  }
  sc.status = aiLabel() + ` is identifying products in ${imgs.length} image${imgs.length > 1 ? 's' : ''}…`;
  render();
  let d = [];
  try {
    d = await geminiDetect(imgs);
    sc.engine = aiLabel();
  } catch (e) {
    toast(e.message, 'err', 5000);
  }
  sc.busy = false;
  sc.dets = d.map(x => {
    const m = Core.matchProduct(x.name, S.products);
    return {
      name: x.name,
      category: CAT[x.category] ? x.category : 'Other',
      count: Math.max(0, +x.count || 1),
      unit: UNITS.includes(x.unit) ? x.unit : 'unit',
      price: m.product ? m.product.price : (+x.price || null),
      confidence: x.confidence,
      box: x.box,
      include: true,
      matchId: m.product?.id || null
    };
  });
  render();
  if (d.length) toast(`Found ${d.length} product type${d.length > 1 ? 's' : ''}`, 'ok');
  else toast('No products recognized — try a closer, well-lit photo', 'warn', 5000);
}

function commit(mode) {
  const rcpt = U.scan.mode === 'rcpt';
  if (rcpt) mode = 'add';
  const src = rcpt ? 'inward_bill' : 'scan';
  const supplier = rcpt && U.scan.rcpt?.store ? U.scan.rcpt.store : '';
  const invNo = rcpt && U.scan.rcpt?.invoiceNo ? U.scan.rcpt.invoiceNo : '';
  let a = 0, u = 0;
  const logged = [];

  U.scan.dets.filter(d => d.include && d.name.trim()).forEach(d => {
    const q = +d.count || 0;
    let p = d.matchId && prod(d.matchId);
    if (p) {
      const b = p.stock;
      p.stock = mode === 'set' ? q : +(p.stock + q).toFixed(3);
      if (d.cost != null && d.cost > 0) p.cost = +d.cost;
      if (d.price != null && d.price > 0) p.price = +d.price;
      else if (rcpt && d.cost && !p.price) p.price = +(d.cost * 1.35).toFixed(2);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: mode === 'set' ? 'adjust' : 'restock',
        qty: +(p.stock - b).toFixed(3),
        delta: +(p.stock - b).toFixed(3),
        ts: Date.now(),
        source: src,
        supplier,
        invoiceNo: invNo
      });
      u++;
      logged.push({ name: p.name, qty: q, unit: p.unit });
    } else {
      const sellPrice = (d.price != null && d.price > 0) ? +d.price : (d.cost ? +(d.cost * 1.35).toFixed(2) : 0);
      p = {
        id: uid(),
        name: d.name.trim(),
        barcode: '',
        aliases: [],
        category: d.category || 'Other',
        unit: d.unit,
        stock: q,
        price: sellPrice,
        cost: +d.cost || 0,
        minStock: null,
        createdAt: Date.now()
      };
      S.products.push(p);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'restock',
        qty: q,
        delta: q,
        ts: Date.now(),
        source: src,
        supplier,
        invoiceNo: invNo
      });
      a++;
      logged.push({ name: p.name, qty: q, unit: p.unit });
    }
  });

  save();
  const summaryMsg = `${rcpt ? '📦 Inward stock logged' : '✅ Inventory updated'}: ${a} new, ${u} updated`;
  toast(summaryMsg, 'ok');

  if (rcpt && supplier) {
    const waText = encodeURIComponent(`📦 *Inward Acknowledgment — ${set().storeName}*\nSupplier: ${supplier}${invNo ? ` (Inv #${invNo})` : ''}\nItems received:\n` + logged.map(it => `• ${fq(it.qty, it.unit)} ${it.name}`).join('\n') + `\n\nStock updated via ShelfSense AI.`);
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'toast ok';
      el.innerHTML = `<span>Delivery recorded. <a href="https://wa.me/?text=${waText}" target="_blank" style="color:#fff;font-weight:700;text-decoration:underline">📲 WhatsApp Supplier</a></span>`;
      $('#toasts').appendChild(el);
      setTimeout(() => el.remove(), 7000);
    }, 400);
  }

  U.scan.image = null; U.scan.dets = []; U.scan.rcpt = null;
  go('stock');
}

/* ---------- Voice Operations ---------- */
async function listen() {
  if (U.voice.recording) return stopRec();
  if (!aiReady() && !hasSpeechRec) return toast('Voice needs an AI backend — Settings → AI backend', 'warn', 5000);
  if (!navigator.mediaDevices?.getUserMedia && !hasSpeechRec) return toast('Microphone needs HTTPS — type the command instead', 'warn', 5000);
  startRec();
}

async function startRec() {
  if (!S.products.length) toast('Tip: add products first (Scan or Load demo)', 'warn');
  const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (SpeechRec) {
    try {
      const rec = new SpeechRec();
      rec.continuous = false;
      rec.interimResults = true;
      rec.lang = set().lang || 'en-US';
      U.voice.transcript = '';
      U.voice.recording = true;
      render();
      rec.onresult = e => {
        let interim = '', final = '';
        for (let i = e.resultIndex; i < e.results.length; ++i) {
          if (e.results[i].isFinal) final += e.results[i][0].transcript;
          else interim += e.results[i][0].transcript;
        }
        const text = (final || interim).trim();
        if (text) {
          U.voice.transcript = text;
          const el = $('#trans');
          if (el) { el.textContent = '“' + text + '”'; el.classList.remove('ph2'); }
        }
      };
      rec.onend = () => {
        U.voice.recording = false;
        U.voice.rec = null;
        render();
        if (U.voice.transcript.trim()) {
          command(U.voice.transcript.trim(), 'voice');
        }
      };
      rec.onerror = e => {
        console.warn('Native speech recognition fallback:', e);
        U.voice.recording = false;
        U.voice.rec = null;
        if (e.error === 'not-allowed') {
          toast('Microphone access denied', 'err');
          render();
        } else if (!U.voice.transcript) {
          startRecAudioContext();
        }
      };
      U.voice.rec = { nativeRec: rec };
      rec.start();
      return;
    } catch (e) {
      console.warn('SpeechRec failed, falling back:', e);
    }
  }
  startRecAudioContext();
}

async function startRecAudioContext() {
  let stream;
  try {
    stream = await navigator.mediaDevices.getUserMedia({ audio: true });
  } catch (e) {
    return toast('Mic unavailable: ' + e.message, 'err', 5000);
  }
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  const src = ctx.createMediaStreamSource(stream);
  const proc = ctx.createScriptProcessor(4096, 1, 1);
  const chunks = [];
  proc.onaudioprocess = e => {
    if (U.voice.recording) chunks.push(new Float32Array(e.inputBuffer.getChannelData(0)));
  };
  src.connect(proc);
  proc.connect(ctx.destination);
  U.voice.rec = { stream, ctx, src, proc, chunks };
  U.voice.recording = true;
  U.voice.transcript = '';
  render();
  U.voice.recCap = setTimeout(() => { if (U.voice.recording) stopRec(); }, 30000);
}

async function stopRec() {
  const r = U.voice.rec;
  if (!r) return;
  if (r.nativeRec) {
    try { r.nativeRec.stop(); } catch (e) {}
    return;
  }
  clearTimeout(U.voice.recCap);
  U.voice.recording = false;
  U.voice.busy = true;
  render();
  try { r.proc.disconnect(); r.src.disconnect(); } catch (e) {}
  r.stream.getTracks().forEach(t => t.stop());
  const wav = encodeWav(r.chunks, r.ctx.sampleRate);
  try { r.ctx.close(); } catch (e) {}
  U.voice.rec = null;
  if (wav.length < 6000) {
    U.voice.busy = false;
    render();
    return toast('No speech caught — tap the mic and speak', 'warn');
  }
  try {
    const text = await aiTranscribe(b64of(wav), set().lang);
    U.voice.busy = false;
    if (!text) {
      render();
      return toast('Nothing heard — try again a little closer to the mic', 'warn', 5000);
    }
    const el = $('#trans');
    if (el) { el.textContent = '“' + text + '”'; el.classList.remove('ph2'); }
    command(text, 'voice');
  } catch (e) {
    U.voice.busy = false;
    render();
    toast('Transcription failed: ' + e.message + ' — you can type the command', 'err', 6000);
  }
}

async function command(text, source) {
  U.voice.transcript = text;
  if (!aiReady()) return toast('Parsing needs an AI backend — Settings → AI backend', 'warn', 5000);
  if (!S.products.length) {
    render();
    return toast('Add products first — Scan the store or Load demo', 'warn');
  }
  U.voice.busy = true;
  render();
  let P;
  try {
    const r = await gemini([{
      text: `You parse sales and inventory voice commands from a grocery shop owner. The command may be in English, Spanish, Hindi (हिन्दी) or Nepali (नेपाली) — including Devanagari script, Devanagari digits (०१२३४५६७८९), and romanized words (chini, bhaat, chamal, chiya, nun, tel, dal, aloo, tamatar, doodh). Half = 0.5, quarter = 0.25, "एक पाउ" ≈ 0.5 kg, "आधा किलो" = 0.5 kg, "पाउ" ≈ 0.55 kg if unsure use 0.5.
Detect:
1) Customer name if mentioned (e.g. "Ramesh ko...", "Amit bhai ka...", "John owes...", "sell to Sarah", "Rohan ke khate me") -> customer: string or null
2) Payment method: if on credit/tab/udhaar/khata (e.g. "udhaar pe", "khata me likho", "on credit", "tab", "paise baad me denge") -> paymentMode: "khata", else "cash".
3) Items: array of {"intent":"sale"|"restock", "product": the inventory name copied VERBATIM — never translate, translate-from or shorten it; null only if nothing in the inventory fits (match by meaning across languages: चिनी/cheeni→Sugar, चामल/भात/chamal/bhaat→Rice, चिया→Tea, नुन→Salt, तेल→oil, दाल→lentils, आलु/aloo→Potato, गोलभेंडा/tamatar→Tomato, दूध/doodh→Milk),"heard": the owner's words for that item, in the original language,"qty": number,"unit":"kg"|"g"|"L"|"ml"|"unit"|"pack"|"dozen"|null}.

Inventory product names: ${JSON.stringify(S.products.map(p => p.name))}.
Command: "${text}"
Return ONLY JSON: {"customer": string|null, "paymentMode": "cash"|"khata", "items": [...]}. sold/bikri/bikri bhayo/becha/vendí/बिक्री/बेचा = sale; received/arrived/delivery/llegaron/आयो/आए/पसलमा आयो/मंगाएको/खरिद = restock.`
    }]);
    P = Core.normalizeModelParse(r, text, S.products);
  } catch (e) {
    U.voice.busy = false;
    render();
    return toast('AI parsing unavailable: ' + e.message, 'warn', 5000);
  }
  U.voice.busy = false;
  if (!P.items.length) {
    render();
    toast("I didn't catch a product. Try: “two bread sold”", 'warn');
    speak('Sorry, I did not catch the product.', set());
    return;
  }
  if (P.customer) U.voice.customer = P.customer;
  if (P.paymentMode) U.voice.paymentMode = P.paymentMode;
  P.items.forEach(it => U.voice.bill.push({
    id: uid(),
    text,
    intent: it.intent || P.intent,
    query: it.query,
    qty: it.qty,
    unit: it.unit,
    productId: it.productId,
    include: true,
    source
  }));
  render();
  toast('🧾 ' + P.items.length + ' line' + (P.items.length > 1 ? 's' : '') + (P.customer ? ` for ${P.customer}` : '') + (P.paymentMode === 'khata' ? ' (📖 Khata)' : ''), 'ok', 2600);
  speak((P.customer ? P.customer + ': ' : '') + (P.items.length === 1 ? 'One item on the bill.' : P.items.length + ' items on the bill.'), set());
}

function billApply(print) {
  const custInput = ($('#billCustomer')?.value || '').trim();
  if (custInput) U.voice.customer = custInput;
  const cname = U.voice.customer || 'Walk-in Customer';
  const isKhata = U.voice.paymentMode === 'khata';
  const rows = U.voice.bill.filter(b => b.include);
  const ok = rows.filter(b => b.productId && prod(b.productId) && +b.qty > 0);
  if (!ok.length) return toast('Nothing to record — pick a product for at least one line', 'warn');

  const msgs = [], alerts = [];
  let total = 0;
  ok.forEach(b => {
    const p = prod(b.productId);
    const q = +Core.convertQty(+b.qty, b.unit || null, p.unit).toFixed(3);
    if (b.intent === 'sale') {
      const over = q > p.stock;
      if (over) alerts.push(`Only ${fq(p.stock, p.unit)} of ${p.name} was in stock — please recount.`);
      const st = p.stock;
      p.stock = Math.max(0, +(p.stock - q).toFixed(3));
      const t = +(q * p.price).toFixed(2);
      total += t;
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'sale',
        qty: q,
        delta: +(p.stock - st).toFixed(3),
        unitPrice: p.price,
        total: t,
        ts: Date.now(),
        source: b.source || 'bill',
        customer: cname,
        paymentMode: U.voice.paymentMode,
        text: over ? [b.text, 'oversold'].filter(Boolean).join(' — ') : b.text
      });
    } else {
      const st = p.stock;
      p.stock = +(p.stock + q).toFixed(3);
      S.moves.push({
        id: uid(),
        productId: p.id,
        type: 'restock',
        qty: q,
        delta: +(p.stock - st).toFixed(3),
        ts: Date.now(),
        source: b.source || 'bill',
        text: b.text
      });
    }
    msgs.push({
      name: p.name,
      qty: q,
      unit: p.unit,
      price: p.price,
      line: b.intent === 'sale' ? +(q * p.price).toFixed(2) : null,
      intent: b.intent
    });
  });

  if (isKhata && total > 0) {
    recordKhataDebit(S.khata, cname, total, msgs.map(m => `${fq(m.qty, m.unit)} ${m.name}`));
  }

  if (ok.some(b => b.intent === 'sale')) {
    const ar = Core.analyze(S.products, S.moves, set()).rows;
    ok.forEach(b => {
      const r = ar.find(x => x.id === b.productId);
      if (r && (r.status === 'low' || r.status === 'out')) {
        alerts.push(`${r.p.name} is ${r.status === 'out' ? 'out of stock' : 'running low'}: ${fq(r.p.stock, r.p.unit)} left. Reorder ${fq(r.reorderQty, r.p.unit)}.`);
      }
    });
  }

  save();
  if (print) printBill(msgs, total);

  const nMiss = rows.filter(b => !b.productId || !prod(b.productId)).length;
  const head = (isKhata ? `📖 ${cname} Khata: ` : 'Bill recorded: ') + msgs.map(m => `${fq(m.qty, m.unit)} ${m.name}`).join(', ');
  toast('✅ ' + head + (total ? ' · ' + money(total, set().currency) : ''), 'ok');

  if (isKhata && total > 0) {
    const outstanding = S.khata[cname]?.balance || total;
    const waBill = encodeURIComponent(`🧾 *Bill Receipt — ${set().storeName}*\nCustomer: ${cname}\nDate: ${new Date().toLocaleDateString()}\n\n` + msgs.map(m => `• ${fq(m.qty, m.unit)} ${m.name}: ${money(m.line, set().currency)}`).join('\n') + `\n\n*Total:* ${money(total, set().currency)}\n*Payment:* 📖 Khata (Store Credit)\n*Outstanding Balance:* ${money(outstanding, set().currency)}\n\nThank you!`);
    setTimeout(() => {
      const el = document.createElement('div');
      el.className = 'toast ok';
      el.innerHTML = `<span>📖 Added to ${cname}'s tab. <a href="https://wa.me/?text=${waBill}" target="_blank" style="color:#fff;font-weight:700;text-decoration:underline">📲 WhatsApp Receipt</a></span>`;
      $('#toasts').appendChild(el);
      setTimeout(() => el.remove(), 7000);
    }, 400);
  }

  U.voice.bill = [];
  U.voice.customer = '';
  U.voice.paymentMode = 'cash';
  render();

  if (nMiss) setTimeout(() => toast(`⚠️ ${nMiss} item${nMiss > 1 ? 's' : ''} not in inventory — skipped. Add them in Stock first, then resell.`, 'warn', 7000), 350);
  [...new Set(alerts)].forEach((a, i) => setTimeout(() => toast('⚠️ ' + a, 'warn', 6500), 350 * (i + 1 + (nMiss ? 1 : 0))));
  speak(head + '. ' + [...new Set(alerts)].join(' '), set());
}

